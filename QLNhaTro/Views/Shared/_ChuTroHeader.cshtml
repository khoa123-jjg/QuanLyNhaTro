<header class="landlord-header">
    <div class="container-fluid landlord-header__inner">
        <div class="landlord-header__left">
            <button class="landlord-header__menu-btn d-lg-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#landlordSidebarCollapse"
                    aria-controls="landlordSidebarCollapse"
                    aria-expanded="false"
                    aria-label="Mở menu">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>

            <a class="landlord-brand" asp-controller="ChuTro" asp-action="TongQuan">
                <svg class="landlord-brand__icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="24" cy="24" r="24" fill="#E8F2FF"/>
                    <path d="M14 22L24 14L34 22V34C34 35.1 33.1 36 32 36H16C14.9 36 14 35.1 14 34V22Z" fill="#0066D9"/>
                    <path d="M18 36V26H30V36" fill="#0052B3"/>
                    <path d="M12 28C12 28 16 24 24 28C32 24 36 28 36 28" stroke="#4DA3FF" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <div>
                    <p class="landlord-brand__title mb-0">PHÒNG TRỌ ĐÀ NẴNG</p>
                    <p class="landlord-brand__slogan mb-0">Tìm phòng dễ dàng, ở trọn an tâm</p>
                </div>
            </a>
        </div>

        <div class="landlord-header__right">

            <button type="button" class="landlord-header__user" aria-label="Tài khoản">
                <span class="landlord-header__user-name">@(User.Identity?.Name ?? "Nguyễn Văn A")</span>
            </button>
        </div>
    </div>
</header>
