@{
    // ActiveAdminMenu: Dashboard | NguoiDung | BaiChoDuyet | TienNghi | DonViHanhChinh | DuongPho | HoSo
    var activeMenu = ViewData["ActiveAdminMenu"]?.ToString() ?? "";
}

<aside class="admin-sidebar collapse d-lg-block" id="adminSidebarCollapse" aria-label="Menu quản trị">
    <div class="admin-sidebar__inner">
        <p class="admin-sidebar__section-title">QUẢN LÝ HỆ THỐNG</p>

        <nav class="admin-sidebar__nav" aria-label="Menu quản trị">
            <a class="admin-sidebar__link @(activeMenu == "Dashboard" ? "is-active" : "")"
               asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2 admin-sidebar__icon" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "NguoiDung" ? "is-active" : "")"
               asp-controller="Admin" asp-action="NguoiDung">
                <i class="bi bi-people admin-sidebar__icon" aria-hidden="true"></i>
                <span>Người dùng</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "BaiChoDuyet" ? "is-active" : "")"
               asp-controller="Admin" asp-action="BaiChoDuyet">
                <i class="bi bi-file-earmark-check admin-sidebar__icon" aria-hidden="true"></i>
                <span>Bài chờ duyệt</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "TienNghi" ? "is-active" : "")"
               asp-controller="Admin" asp-action="TienNghi">
                <i class="bi bi-grid admin-sidebar__icon" aria-hidden="true"></i>
                <span>Tiện nghi</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "DonViHanhChinh" ? "is-active" : "")"
               asp-controller="Admin" asp-action="DonViHanhChinh">
                <i class="bi bi-building admin-sidebar__icon" aria-hidden="true"></i>
                <span>Đơn vị hành chính</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "DuongPho" ? "is-active" : "")"
               asp-controller="Admin" asp-action="DuongPho">
                <i class="bi bi-geo-alt admin-sidebar__icon" aria-hidden="true"></i>
                <span>Đường phố</span>
            </a>
            <a class="admin-sidebar__link @(activeMenu == "HoSo" ? "is-active" : "")"
               asp-controller="Admin" asp-action="HoSo">
                <i class="bi bi-person-badge admin-sidebar__icon" aria-hidden="true"></i>
                <span>Hồ sơ admin</span>
            </a>
        </nav>

        <div class="admin-card admin-sidebar__support">
            <h2 class="admin-sidebar__support-title">Hỗ trợ admin</h2>
            <p class="admin-sidebar__support-item mb-1">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                <a href="tel:0901234567">0901 234 567</a>
            </p>
            <p class="admin-sidebar__support-item mb-0">
                <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                <a href="mailto:admin@phongtrodannang.vn">admin@phongtrodannang.vn</a>
            </p>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" class="admin-sidebar__logout-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="admin-sidebar__logout">
                <i class="bi bi-box-arrow-right admin-sidebar__icon" aria-hidden="true"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>
</aside>
