@*
    Partial card phòng — dùng lại trang chủ & danh sách phòng.

    Cách gọi:
    @await Html.PartialAsync("_RoomCard", phongCard)
*@
@model QLNhaTro.Models.PhongTro.PhongTroCardViewModel

@{
    var giaThueHienThi = $"{FormatHelper.FormatGiaThue(Model.GiaThue)}/tháng";
    var dienTichHienThi = FormatHelper.FormatDienTich(Model.DienTich);
    var coThongTinPhu = !string.IsNullOrWhiteSpace(Model.ThongTinPhu);
}

<article class="room-card h-100">
    <a class="room-card__link d-flex flex-column h-100 text-decoration-none"
       asp-controller="PhongTro"
       asp-action="ChiTiet"
       asp-route-id="@Model.Id">
        <div class="room-card__media">
            <img class="room-card__img"
                 src="@Model.AnhDaiDien"
                 alt="@Model.TieuDe"
                 loading="lazy" />
            <button type="button"
                    class="room-card__favorite"
                    aria-label="Thêm vào yêu thích"
                    onclick="event.preventDefault(); event.stopPropagation();">
                <i class="bi bi-heart" aria-hidden="true"></i>
            </button>
        </div>
        <div class="room-card__body">
            <h3 class="room-card__title">@Model.TieuDe</h3>
            <p class="room-card__location mb-0">
                <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                @Model.KhuVuc
            </p>
            <p class="room-card__meta mb-0">
                @dienTichHienThi
                @if (coThongTinPhu)
                {
                    <span class="room-card__meta-dot">•</span>
                    @Model.ThongTinPhu
                }
            </p>
            <p class="room-card__price mb-0">@giaThueHienThi</p>
        </div>
    </a>
</article>
