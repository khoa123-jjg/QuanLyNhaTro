@model QLNhaTro.Models.Admin.NguoiDung.AdminNguoiDungListPageViewModel
@using QLNhaTro.Helpers.Constants
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActiveAdminMenu"] = "NguoiDung";
}

<section class="admin-page admin-list-page admin-user-list">
    <header class="admin-page-header">
        <h1 class="admin-page-title">Quản lý người dùng</h1>
        <p class="admin-page-subtitle mb-0">Xem danh sách, tìm kiếm người dùng</p>
    </header>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="admin-card admin-filter-card mb-4">
        <form class="admin-filter-bar" method="get" novalidate>
            <div class="admin-filter-bar__field admin-filter-bar__field--search">
                <label class="admin-form__label" for="TuKhoa">Tìm kiếm</label>
                <div class="admin-input-icon">
                    <i class="bi bi-search admin-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="TuKhoa" name="TuKhoa" type="search" value="@Model.TuKhoa" placeholder="Tìm kiếm theo tên, email, SĐT..." />
                </div>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="VaiTro">Vai trò</label>
                <select class="form-select admin-filter-select" id="VaiTro" name="VaiTro">
                    @foreach (var item in Model.DanhSachVaiTro)
                    {
                        <option value="@item.Value" selected="@(string.Equals(item.Value, Model.VaiTro, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="TrangThai">Trạng thái</label>
                <select class="form-select admin-filter-select" id="TrangThai" name="TrangThai">
                    @foreach (var item in Model.DanhSachTrangThai)
                    {
                        <option value="@item.Value" selected="@(string.Equals(item.Value, Model.TrangThai, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="admin-filter-bar__action">
                <span class="admin-form__label admin-filter-bar__action-label" aria-hidden="true">&nbsp;</span>
                <button type="submit" class="btn btn-admin-primary">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    Lọc
                </button>
            </div>
        </form>
    </div>

    <article class="admin-card admin-table-card">
        <div class="admin-table-wrap">
            <table class="table admin-data-table mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="admin-data-table__col-stt">STT</th>
                        <th scope="col">Họ tên</th>
                        <th scope="col">Email</th>
                        <th scope="col">Vai trò</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.NguoiDungs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">Không có người dùng phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.NguoiDungs)
                        {
                            <tr>
                                <td>@item.Stt</td>
                                <td><strong>@item.HoTen</strong></td>
                                <td>@item.Email</td>
                                <td><span class="admin-badge admin-badge--role-admin">@item.VaiTroText</span></td>
                                <td>
                                    @if (NguoiDungStatus.IsActive(item.TrangThai))
                                    {
                                        <span class="admin-badge admin-badge--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @item.TrangThaiText</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--danger"><i class="bi bi-lock-fill" aria-hidden="true"></i> @item.TrangThaiText</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="admin-table-actions">
                                        <a class="admin-action-btn"
                                           asp-controller="Admin"
                                           asp-action="ChiTietNguoiDung"
                                           asp-route-id="@item.Id"
                                           aria-label="Xem chi tiết">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <form asp-controller="Admin"
                                              asp-action="KhoaMoKhoaNguoiDung"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="admin-action-btn"
                                                    title="Khóa hoặc mở khóa tài khoản">
                                                @if (NguoiDungStatus.IsActive(item.TrangThai))
                                                {
                                                    <i class="bi bi-lock" aria-hidden="true"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-unlock" aria-hidden="true"></i>
                                                }
                                            </button>
                                        </form>
                                        <form asp-controller="Admin"
                                              asp-action="XoaNguoiDung"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="admin-action-btn admin-action-btn--danger"
                                                    title="Xóa người dùng">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>
