@model QLNhaTro.Models.Admin.DiaChi.QuanHuyenPageViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Quận/Huyện";
    ViewData["ActiveAdminMenu"] = "QuanHuyen";
}

<section class="admin-page admin-list-page admin-unit-page">
    <header class="admin-page-header">
        <h1 class="admin-page-title">Quản lý Quận/Huyện</h1>
        <p class="admin-page-subtitle mb-0">Quản lý danh sách quận/huyện trực thuộc thành phố</p>
    </header>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="admin-split-layout admin-split-layout--side-form">
        <div class="admin-split-layout__main">
            <div class="admin-card admin-filter-card mb-4">
                <form class="admin-filter-bar admin-filter-bar--unit" method="get">
                    <div class="admin-filter-bar__field admin-filter-bar__field--search w-100">
                        <label class="admin-form__label" for="searchDonVi">Tìm kiếm</label>
                        <div class="admin-input-icon">
                            <i class="bi bi-search admin-input-icon__icon" aria-hidden="true"></i>
                            <input class="form-control" id="searchDonVi" name="tuKhoa" type="search" value="@Model.TuKhoa" placeholder="Tìm kiếm tên quận/huyện hoặc thành phố..." />
                        </div>
                    </div>
                    <div class="admin-filter-bar__action">
                        <span class="admin-form__label admin-filter-bar__action-label" aria-hidden="true">&nbsp;</span>
                        <button type="submit" class="btn btn-admin-primary">
                            <i class="bi bi-funnel" aria-hidden="true"></i>
                            Lọc
                        </button>
                    </div>
                </form>
            </div>

            <article class="admin-card admin-table-card">
                <div class="admin-table-wrap">
                    <table class="table admin-data-table mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="admin-data-table__col-stt">STT</th>
                                <th scope="col">Tên quận/huyện</th>
                                <th scope="col">Thành phố</th>
                                <th scope="col" class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DanhSachQuanHuyen.Count > 0)
                            {
                                for (var i = 0; i < Model.DanhSachQuanHuyen.Count; i++)
                                {
                                    var item = Model.DanhSachQuanHuyen[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><strong>@item.TenQuanHuyen</strong></td>
                                        <td>@item.ThanhPho</td>
                                        <td class="text-end">
                                            <div class="admin-table-actions">
                                                <a class="admin-action-btn" asp-action="QuanHuyen" asp-route-id="@item.Id" aria-label="Sửa"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                                <form asp-action="XoaQuanHuyen" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa quận/huyện này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="admin-action-btn admin-action-btn--danger" aria-label="Xóa"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">Chưa có quận/huyện nào phù hợp.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="admin-pagination-bar admin-pagination-bar--bordered" aria-label="Phân trang quận huyện">
                    <p class="admin-pagination-bar__summary mb-0">Hiển thị 1 - @Model.DanhSachQuanHuyen.Count của @Model.DanhSachQuanHuyen.Count quận/huyện</p>
                </nav>
            </article>
        </div>

        <aside class="admin-card admin-side-form-card">
            <div class="admin-card__header">
                <h2 class="admin-card__title mb-0">Thêm / Sửa quận huyện</h2>
            </div>
            <div class="admin-card__body">
                <form class="admin-form admin-side-form" asp-action="LuuQuanHuyen" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Form.Id" />
                    <div class="mb-3">
                        <label class="admin-form__label" asp-for="Form.TenQuanHuyen">Tên quận/huyện <span class="admin-required">*</span></label>
                        <input class="form-control" asp-for="Form.TenQuanHuyen" />
                        <span class="text-danger" asp-validation-for="Form.TenQuanHuyen"></span>
                    </div>
                    <div class="mb-4">
                        <label class="admin-form__label" asp-for="Form.ThanhPho">Thành phố <span class="admin-required">*</span></label>
                        <input class="form-control" asp-for="Form.ThanhPho" />
                        <span class="text-danger" asp-validation-for="Form.ThanhPho"></span>
                    </div>
                    <div class="admin-side-form-card__actions">
                        <button type="submit" class="btn btn-admin-primary w-100">
                            <i class="bi bi-save" aria-hidden="true"></i>
                            Lưu
                        </button>
                        <a class="btn btn-admin-outline w-100" asp-action="QuanHuyen">Hủy</a>
                    </div>
                </form>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
