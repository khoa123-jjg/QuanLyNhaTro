@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Khóa / Mở khóa tài khoản";
    ViewData["ActiveAdminMenu"] = "NguoiDung";
}

<section class="admin-page admin-form-page admin-user-lock">
    <header class="admin-page-header admin-page-header--with-back">
        <a class="admin-back-btn" asp-controller="Admin" asp-action="NguoiDung" aria-label="Quay lại">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h1 class="admin-page-title">Khóa / Mở khóa tài khoản</h1>
            <p class="admin-breadcrumb mb-0">
                <a asp-controller="Admin" asp-action="NguoiDung">Quản lý người dùng</a>
                <span aria-hidden="true"> / </span>
                <span>Khóa / Mở khóa tài khoản</span>
            </p>
        </div>
    </header>

    <article class="admin-card admin-user-lock-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title mb-0">Cập nhật trạng thái tài khoản</h2>
        </div>
        <div class="admin-card__body">
            <div class="admin-user-summary">
                <img class="admin-user-summary__avatar"
                     src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=120&h=120&fit=crop&crop=face"
                     alt="" />
                <div class="admin-user-summary__meta">
                    <p class="admin-user-summary__name mb-1">Hoàng Văn E</p>
                    <p class="admin-user-summary__email mb-1">nguoithue.e@gmail.com</p>
                    <p class="admin-user-summary__role mb-0">
                        <span class="admin-badge admin-badge--role-tenant">Người thuê</span>
                    </p>
                </div>
                <span class="admin-badge admin-badge--danger admin-user-summary__status">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i> Bị khóa
                </span>
            </div>

            <form class="admin-form admin-user-lock-form" action="#" method="post" novalidate>
                <div class="mb-3">
                    <label class="admin-form__label" for="trangThaiMoi">
                        Trạng thái mới <span class="admin-required">*</span>
                    </label>
                    <select class="form-select" id="trangThaiMoi">
                        <option>Hoạt động (Mở khóa)</option>
                        <option selected>Bị khóa</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="admin-form__label" for="lyDoKhoaMo">
                        Lý do <span class="admin-required">*</span>
                    </label>
                    <textarea class="form-control" id="lyDoKhoaMo" rows="4">Mở khóa theo yêu cầu. Đã cam kết tuân thủ quy định.</textarea>
                    <p class="admin-char-counter mb-0">59/255</p>
                </div>

                <div class="admin-page-actions admin-user-lock-form__actions">
                    <button type="button" class="btn btn-admin-outline">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                        Khóa tài khoản
                    </button>
                    <button type="button" class="btn btn-admin-primary">
                        <i class="bi bi-unlock-fill" aria-hidden="true"></i>
                        Mở khóa tài khoản
                    </button>
                    <a class="btn btn-admin-outline" asp-controller="Admin" asp-action="NguoiDung">Hủy</a>
                </div>
            </form>

            <p class="admin-note mb-0">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Việc khóa/mở khóa tài khoản sẽ có hiệu lực ngay và người dùng sẽ nhận được thông báo.
            </p>
        </div>
    </article>
</section>
