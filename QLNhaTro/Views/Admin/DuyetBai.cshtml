@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Duyệt bài";
    ViewData["ActiveAdminMenu"] = "BaiChoDuyet";
}

<section class="admin-page admin-form-page admin-post-approve">
    <header class="admin-page-header admin-page-header--with-back">
        <a class="admin-back-btn" asp-controller="Admin" asp-action="ChiTietBaiChoDuyet" aria-label="Quay lại">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h1 class="admin-page-title">Duyệt bài</h1>
            <p class="admin-page-subtitle mb-0">Xem và xác nhận duyệt bài đăng</p>
        </div>
    </header>

    <article class="admin-card admin-post-review-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title mb-0">Thông tin bài đăng</h2>
        </div>
        <div class="admin-card__body">
            <div class="admin-info-grid">
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-card-text"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Tiêu đề</p>
                        <p class="admin-info-row__value mb-0">Phòng trọ mới đường Lê Duẩn</p>
                    </div>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-person"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Chủ trọ</p>
                        <p class="admin-info-row__value mb-0">Nguyễn Văn A</p>
                    </div>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-building"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Nhà trọ</p>
                        <p class="admin-info-row__value mb-0">Nhà trọ An Bình</p>
                    </div>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-calendar-event"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Ngày gửi</p>
                        <p class="admin-info-row__value mb-0">12/05/2025 10:20</p>
                    </div>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Trạng thái hiện tại</p>
                        <p class="admin-info-row__value mb-0">
                            <span class="admin-badge admin-badge--warning"><i class="bi bi-clock-fill" aria-hidden="true"></i> Chờ duyệt</span>
                        </p>
                    </div>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-row__icon" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                    <div>
                        <p class="admin-info-row__label mb-0">Trạng thái mới</p>
                        <p class="admin-info-row__value mb-0">
                            <span class="admin-badge admin-badge--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Đã duyệt</span>
                        </p>
                    </div>
                </div>
            </div>

            <form class="admin-form admin-post-review-form" action="#" method="post" novalidate>
                <div class="mb-4">
                    <label class="admin-form__label" for="ghiChuDuyet">Ghi chú (không bắt buộc)</label>
                    <textarea class="form-control" id="ghiChuDuyet" rows="4" placeholder="Nhập ghi chú (nếu có)..."></textarea>
                    <p class="admin-char-counter mb-0">0/255</p>
                </div>

                <div class="admin-page-actions admin-post-review-form__actions">
                    <a class="btn btn-admin-outline" asp-controller="Admin" asp-action="ChiTietBaiChoDuyet">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        Quay lại
                    </a>
                    <button type="button" class="btn btn-admin-accent">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        Duyệt bài
                    </button>
                </div>
            </form>
        </div>
    </article>
</section>
