@{
    ViewData["Title"] = "Gửi yêu cầu thuê";
    ViewData["ActiveTenantMenu"] = "GuiYeuCau";
}

<section class="tenant-request-page">
    <div class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb" class="tenant-breadcrumb mb-3">
            <ol class="breadcrumb mb-0 tenant-breadcrumb__list">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" aria-label="Trang chủ">
                        <i class="bi bi-house-door-fill tenant-breadcrumb__home-icon" aria-hidden="true"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Gửi yêu cầu thuê</li>
            </ol>
        </nav>

        <header class="tenant-page-header mb-4">
            <h1 class="tenant-page-header__title">Gửi yêu cầu thuê</h1>
            <p class="tenant-page-header__subtitle">
                Nhập thông tin liên hệ, ngày xem phòng và lời nhắn cho chủ trọ.
            </p>
        </header>

        <div class="tenant-page-layout tenant-page-layout--request">
            <div class="tenant-page-layout__main">
                <div class="row g-4 rent-request-cards">
                    <div class="col-lg-6">
                        <div class="tenant-card rent-request-room-card">
                            <h2 class="rent-request-card__title">Thông tin phòng đã chọn</h2>

                            <div class="rent-request-room__media">
                                <img class="rent-request-room__image"
                                     src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&h=520&fit=crop"
                                     alt="Phòng studio ban công thoáng mát" />
                                <span class="rent-request-room__rating">
                                    <i class="bi bi-star-fill" aria-hidden="true"></i>
                                    4.8 (23)
                                </span>
                            </div>

                            <h3 class="rent-request-room__name">Phòng studio ban công thoáng mát</h3>
                            <p class="rent-request-room__address">
                                <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                Đường 7, Hòa Minh, Liên Chiểu, Đà Nẵng
                            </p>
                            <p class="rent-request-room__price">4.500.000 đ/tháng</p>

                            <div class="room-info-grid rent-request-room__grid">
                                <div class="room-info-grid__item">
                                    <span class="room-info-grid__label">Diện tích</span>
                                    <span class="room-info-grid__value">28 m²</span>
                                </div>
                                <div class="room-info-grid__item">
                                    <span class="room-info-grid__label">Nội thất</span>
                                    <span class="room-info-grid__value">Đầy đủ</span>
                                </div>
                                <div class="room-info-grid__item">
                                    <span class="room-info-grid__label">Tầng</span>
                                    <span class="room-info-grid__value">Tầng 3</span>
                                </div>
                                <div class="room-info-grid__item">
                                    <span class="room-info-grid__label">Hướng</span>
                                    <span class="room-info-grid__value">Đông Nam</span>
                                </div>
                                <div class="room-info-grid__item rent-request-room__grid-wide">
                                    <span class="room-info-grid__label">Tiện ích</span>
                                    <span class="room-info-grid__value">Gần chợ, gần trường, wifi, máy giặt chung</span>
                                </div>
                                <div class="room-info-grid__item">
                                    <span class="room-info-grid__label">Ngày đăng</span>
                                    <span class="room-info-grid__value">20/05/2025</span>
                                </div>
                            </div>

                            <a class="btn-rent-request-room-detail" asp-controller="PhongTro" asp-action="ChiTiet">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                Xem chi tiết phòng
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="tenant-card rent-request-form-card">
                            <h2 class="rent-request-card__title">Thông tin liên hệ &amp; yêu cầu</h2>

                            <form class="rent-request-form" action="#" method="post" novalidate>
                                <div class="rent-request-field mb-3">
                                    <label class="rent-request-field__label" for="hoTenLienHe">Họ tên liên hệ</label>
                                    <div class="rent-request-field__control">
                                        <i class="bi bi-person rent-request-field__icon" aria-hidden="true"></i>
                                        <input class="form-control rent-request-field__input"
                                               id="hoTenLienHe"
                                               type="text"
                                               value="Nguyễn Văn A" />
                                    </div>
                                </div>

                                <div class="rent-request-field mb-3">
                                    <label class="rent-request-field__label" for="soDienThoai">Số điện thoại</label>
                                    <div class="rent-request-field__control">
                                        <i class="bi bi-telephone rent-request-field__icon" aria-hidden="true"></i>
                                        <input class="form-control rent-request-field__input"
                                               id="soDienThoai"
                                               type="text"
                                               value="0901 234 567" />
                                    </div>
                                </div>

                                <div class="rent-request-field mb-3">
                                    <label class="rent-request-field__label" for="ngayXemPhong">Ngày muốn xem phòng</label>
                                    <div class="rent-request-field__control">
                                        <i class="bi bi-calendar-event rent-request-field__icon" aria-hidden="true"></i>
                                        <input class="form-control rent-request-field__input"
                                               id="ngayXemPhong"
                                               type="text"
                                               placeholder="Chọn ngày muốn xem phòng" />
                                    </div>
                                </div>

                                <div class="rent-request-field mb-3">
                                    <label class="rent-request-field__label" for="loiNhan">Lời nhắn</label>
                                    <div class="rent-request-field__control rent-request-field__control--textarea">
                                        <i class="bi bi-chat-left-text rent-request-field__icon rent-request-field__icon--top" aria-hidden="true"></i>
                                        <div class="rent-request-field__textarea-wrap">
                                            <textarea class="form-control rent-request-field__textarea"
                                                      id="loiNhan"
                                                      rows="4"
                                                      maxlength="300"
                                                      placeholder="Nhập lời nhắn cho chủ nhà (nếu có)..."></textarea>
                                            <span class="rent-request-field__counter">0/300</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="rent-request-form__notice" role="status">
                                    <i class="bi bi-info-circle-fill rent-request-form__notice-icon" aria-hidden="true"></i>
                                    <p class="rent-request-form__notice-text mb-0">
                                        Chủ trọ sẽ liên hệ lại với bạn để xác nhận thời gian xem phòng phù hợp và cung cấp thêm thông tin chi tiết (nếu cần).
                                    </p>
                                </div>

                                <button type="button" class="btn-rent-request-submit">
                                    <i class="bi bi-send-fill" aria-hidden="true"></i>
                                    Gửi yêu cầu
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tenant-aside-stack">
                @await Html.PartialAsync("_NguoiThueSidebar")
                @await Html.PartialAsync("_NguoiThueSupport")
            </div>
        </div>
    </div>
</section>
