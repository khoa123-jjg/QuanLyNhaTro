@{
    ViewData["Title"] = "Hủy yêu cầu thuê";
    ViewData["ActiveTenantMenu"] = "YeuCauCuaToi";
    ViewData["ActiveNav"] = "my-requests";
}

<section class="tenant-cancel-request-page">
    <div class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb" class="tenant-breadcrumb mb-3">
            <ol class="breadcrumb mb-0 tenant-breadcrumb__list">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" aria-label="Trang chủ">
                        <i class="bi bi-house-door-fill tenant-breadcrumb__home-icon" aria-hidden="true"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="YeuCauThue" asp-action="DanhSach">Yêu cầu của tôi</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Hủy yêu cầu</li>
            </ol>
        </nav>

        <header class="tenant-page-header mb-4">
            <h1 class="tenant-page-header__title">Xác nhận hủy yêu cầu thuê</h1>
            <p class="tenant-page-header__subtitle">Vui lòng xem lại thông tin yêu cầu thuê trước khi hủy.</p>
        </header>

        <div class="tenant-page-layout tenant-page-layout--cancel-request">
            <div class="tenant-page-layout__main">
                <div class="tenant-card rent-request-cancel-card">
                    <div class="row g-4 g-xl-5 rent-request-cancel-card__body">
                        <div class="col-lg-6">
                            <h2 class="rent-request-cancel-card__title">Thông tin yêu cầu</h2>
                            <ul class="rent-request-cancel-info list-unstyled mb-0">
                                <li class="rent-request-cancel-info__item">
                                    <span class="rent-request-cancel-info__icon" aria-hidden="true">
                                        <i class="bi bi-upc-scan"></i>
                                    </span>
                                    <div>
                                        <span class="rent-request-cancel-info__label">Mã yêu cầu</span>
                                        <span class="rent-request-cancel-info__value rent-request-cancel-info__value--code">YC250512001</span>
                                    </div>
                                </li>
                                <li class="rent-request-cancel-info__item">
                                    <span class="rent-request-cancel-info__icon" aria-hidden="true">
                                        <i class="bi bi-door-open"></i>
                                    </span>
                                    <div>
                                        <span class="rent-request-cancel-info__label">Phòng</span>
                                        <span class="rent-request-cancel-info__value">Phòng gác lửng – Hòa Minh</span>
                                    </div>
                                </li>
                                <li class="rent-request-cancel-info__item">
                                    <span class="rent-request-cancel-info__icon" aria-hidden="true">
                                        <i class="bi bi-cash-stack"></i>
                                    </span>
                                    <div>
                                        <span class="rent-request-cancel-info__label">Giá thuê</span>
                                        <span class="rent-request-cancel-info__value rent-request-cancel-info__value--price">2.000.000 đ/tháng</span>
                                    </div>
                                </li>
                                <li class="rent-request-cancel-info__item">
                                    <span class="rent-request-cancel-info__icon" aria-hidden="true">
                                        <i class="bi bi-calendar3"></i>
                                    </span>
                                    <div>
                                        <span class="rent-request-cancel-info__label">Ngày gửi</span>
                                        <span class="rent-request-cancel-info__value">12/05/2025 14:30</span>
                                    </div>
                                </li>
                                <li class="rent-request-cancel-info__item">
                                    <span class="rent-request-cancel-info__icon" aria-hidden="true">
                                        <i class="bi bi-flag"></i>
                                    </span>
                                    <div>
                                        <span class="rent-request-cancel-info__label">Trạng thái hiện tại</span>
                                        <span class="rent-request-status rent-request-status--moi">
                                            <span class="rent-request-status__dot" aria-hidden="true"></span>
                                            Mới
                                        </span>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="col-lg-6">
                            <h2 class="rent-request-cancel-card__title">Lý do hủy</h2>
                            <form class="rent-request-cancel-form" action="#" method="post" novalidate>
                                <div class="mb-3">
                                    <label class="rent-request-cancel-form__label" for="lyDoHuy">
                                        Lý do hủy <span class="rent-request-cancel-form__required" aria-hidden="true">*</span>
                                    </label>
                                    <select class="form-select rent-request-cancel-form__control" id="lyDoHuy">
                                        <option value="" selected disabled>Chọn lý do hủy</option>
                                        <option>Đã tìm được phòng khác</option>
                                        <option>Thay đổi kế hoạch thuê</option>
                                        <option>Thông tin phòng không phù hợp</option>
                                        <option>Lý do khác</option>
                                    </select>
                                </div>

                                <div class="mb-0">
                                    <label class="rent-request-cancel-form__label" for="loiNhanThem">Lời nhắn thêm (nếu có)</label>
                                    <div class="rent-request-cancel-form__textarea-wrap">
                                        <textarea class="form-control rent-request-cancel-form__textarea"
                                                  id="loiNhanThem"
                                                  rows="4"
                                                  maxlength="200"
                                                  placeholder="Nhập lời nhắn thêm..."></textarea>
                                        <span class="rent-request-cancel-form__counter">0/200</span>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="rent-request-cancel-warning" role="alert">
                        <i class="bi bi-exclamation-triangle-fill rent-request-cancel-warning__icon" aria-hidden="true"></i>
                        <p class="rent-request-cancel-warning__text mb-0">
                            Chỉ yêu cầu có trạng thái <strong>MỚI</strong> mới được phép hủy.
                        </p>
                    </div>

                    <div class="rent-request-cancel-actions">
                        <a class="btn-rent-request-cancel-back" asp-controller="YeuCauThue" asp-action="DanhSach">Quay lại</a>
                        <button type="button" class="btn-rent-request-cancel-confirm">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            Xác nhận hủy
                        </button>
                    </div>
                </div>
            </div>

            <div class="tenant-aside-stack">
                @await Html.PartialAsync("_TenantSidebar")
                @await Html.PartialAsync("_TenantSupport")
            </div>
        </div>
    </div>
</section>
