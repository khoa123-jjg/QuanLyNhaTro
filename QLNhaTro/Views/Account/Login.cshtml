@model QLNhaTro.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["ActiveNav"] = "login";
}

<section class="auth-page auth-page--login">
    <div class="auth-hero">
        <div class="auth-hero__overlay">
            <div class="container">
                <div class="auth-hero__content">
                    <div class="auth-hero__badge">
                        <i class="bi bi-building" aria-hidden="true"></i>
                        Phòng trọ Đà Nẵng
                    </div>
                    <h1 class="auth-hero__title">Tìm phòng trọ dễ dàng hơn với không gian sống phù hợp</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="container auth-page__container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-11 col-md-9 col-lg-7 col-xl-5">
                <div class="auth-card">
                    <div class="auth-icon">
                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                    </div>

                    <h2 class="auth-title">ĐĂNG NHẬP</h2>
                    <p class="auth-subtitle">Chào mừng bạn quay trở lại!</p>

                    <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="auth-form-group mb-3">
                            <label class="form-label auth-label" asp-for="Email">Email</label>
                            <div class="auth-input-wrap">
                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                <input asp-for="Email" type="email" class="form-control auth-input" placeholder="Nhập email của bạn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="auth-form-group mb-3">
                            <label class="form-label auth-label" asp-for="MatKhau">Mật khẩu</label>
                            <div class="auth-input-wrap">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <input asp-for="MatKhau" type="password" class="form-control auth-input auth-input--password" placeholder="Nhập mật khẩu" />
       
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="auth-options">
                            <div class="form-check auth-remember">
                                <input class="form-check-input" asp-for="GhiNhoDangNhap" />
                                <label class="form-check-label" asp-for="GhiNhoDangNhap">Ghi nhớ đăng nhập</label>
                            </div>
                        </div>

                        <button type="submit" class="btn auth-submit">Đăng nhập</button>

                        <div class="auth-divider">
                            <span>hoặc</span>
                        </div>

                        <p class="auth-register-text">
                            Chưa có tài khoản?
                            <a asp-controller="Account" asp-action="Register">Đăng ký tại đây</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
