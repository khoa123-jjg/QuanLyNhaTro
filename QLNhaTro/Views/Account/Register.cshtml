@model QLNhaTro.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["ActiveNav"] = "register";
}

<section class="register-page">
    <div class="register-page__overlay">
        <div class="container py-4 py-lg-5">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-lg-6">
                    <div class="register-intro">
                        <div class="register-intro__badge">
                            <i class="bi bi-house-heart" aria-hidden="true"></i>
                            Phòng Trọ Đà Nẵng
                        </div>
                        <h1 class="register-intro__title">Chào mừng bạn đến với Phòng Trọ Đà Nẵng.</h1>
                        <p class="register-intro__desc">
                            Tạo tài khoản để khám phá hàng ngàn phòng trọ phù hợp với nhu cầu của bạn.
                        </p>

                        <div class="register-benefits">
                            <div class="register-benefits__item">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>An toàn &amp; tin cậy.</span>
                            </div>
                            <div class="register-benefits__item">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <span>Tìm kiếm dễ dàng.</span>
                            </div>
                            <div class="register-benefits__item">
                                <i class="bi bi-headset" aria-hidden="true"></i>
                                <span>Hỗ trợ tận tâm 24/7.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 col-xl-5 offset-xl-1">
                    <div class="register-card">
                        <div class="register-card__icon-wrap">
                            <i class="bi bi-person-fill" aria-hidden="true"></i>
                        </div>

                        <h2 class="register-card__title">ĐĂNG KÝ TÀI KHOẢN</h2>
                        <p class="register-card__subtitle">Vui lòng điền thông tin để tạo tài khoản mới.</p>

                        <form asp-controller="Account" asp-action="Register" method="post" class="register-form" autocomplete="off">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="mb-3">
                                <label class="form-label register-form__label" asp-for="HoTen">Họ tên</label>
                                <input asp-for="HoTen" type="text" class="form-control register-form__input" placeholder="Nhập họ tên" />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label register-form__label" asp-for="Email">Email</label>
                                <input asp-for="Email" type="email" class="form-control register-form__input" placeholder="Nhập email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label register-form__label" asp-for="SoDienThoai">Số điện thoại</label>
                                <input asp-for="SoDienThoai" type="tel" class="form-control register-form__input" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label register-form__label" asp-for="MatKhau">Mật khẩu</label>
                                <div class="register-input-wrap">
                                    <input asp-for="MatKhau" type="password" class="form-control register-form__input register-form__input--password" placeholder="Nhập mật khẩu" />
                                    <button type="button" class="register-form__toggle" aria-label="Hiện hoặc ẩn mật khẩu">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label register-form__label" asp-for="XacNhanMatKhau">Xác nhận mật khẩu</label>
                                <div class="register-input-wrap">
                                    <input asp-for="XacNhanMatKhau" type="password" class="form-control register-form__input register-form__input--password" placeholder="Nhập lại mật khẩu" />
                                    <button type="button" class="register-form__toggle" aria-label="Hiện hoặc ẩn mật khẩu">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                            </div>

                            <div class="register-role">
                                <label class="register-form__label d-block mb-2">Vai trò</label>
                                <div class="register-role__options">
                                    <label class="register-role__option">
                                        <input type="radio" asp-for="VaiTroDangKy" value="NGUOI_THUE" />
                                        <span>Người thuê</span>
                                    </label>
                                    <label class="register-role__option">
                                        <input type="radio" asp-for="VaiTroDangKy" value="CHU_TRO" />
                                        <span>Chủ trọ</span>
                                    </label>
                                </div>
                                <span asp-validation-for="VaiTroDangKy" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn register-form__submit">Tạo tài khoản</button>

                            <p class="register-form__login-text">
                                Đã có tài khoản?
                                <a asp-controller="Account" asp-action="Login">Đăng nhập tại đây</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
