@model QLNhaTro.Models.PhongTro.PhongTroSearchViewModel
@{
    ViewData["Title"] = "Danh sách phòng trọ";
    ViewData["ActiveNav"] = "rooms";
    var soKetQua = Model.DanhSachPhong.Count;
}

<!-- Banner đầu trang -->
<section class="phong-banner" aria-labelledby="phongBannerTitle">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 id="phongBannerTitle" class="phong-banner__title">Danh sách phòng trọ</h1>
                <p class="phong-banner__subtitle">
                    Tìm kiếm và lựa chọn phòng trọ phù hợp tại Đà Nẵng
                </p>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="phong-banner__art" aria-hidden="true"></div>
            </div>
        </div>
    </div>
</section>

<!-- Nội dung chính -->
<div class="container phong-list-page">
    <div class="row g-4">
        <!-- Bộ lọc -->
        <aside class="col-lg-3">
            <div class="phong-filter">
                <h2 class="phong-filter__title">
                    <i class="bi bi-sliders" aria-hidden="true"></i>
                    BỘ LỌC TÌM KIẾM
                </h2>

                <form class="phong-filter__form" asp-controller="PhongTro" asp-action="Index" method="get">
                    <div class="phong-filter__group">
                        <label class="phong-filter__label" for="filterQuan">Khu vực / Quận</label>
                        <select class="form-select phong-filter__select" id="filterQuan" name="khuVuc">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.KhuVuc))">Tất cả quận</option>
                            <option value="lien-chieu" selected="@(Model.KhuVuc == "lien-chieu")">Liên Chiểu</option>
                            <option value="thanh-khe" selected="@(Model.KhuVuc == "thanh-khe")">Thanh Khê</option>
                            <option value="hai-chau" selected="@(Model.KhuVuc == "hai-chau")">Hải Châu</option>
                            <option value="son-tra" selected="@(Model.KhuVuc == "son-tra")">Sơn Trà</option>
                            <option value="ngu-hanh-son" selected="@(Model.KhuVuc == "ngu-hanh-son")">Ngũ Hành Sơn</option>
                            <option value="cam-le" selected="@(Model.KhuVuc == "cam-le")">Cẩm Lệ</option>
                        </select>
                    </div>

                    <div class="phong-filter__group">
                        <label class="phong-filter__label" for="filterGia">Mức giá (đ/tháng)</label>
                        <select class="form-select phong-filter__select" id="filterGia" name="mucGia">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.MucGia))">Mọi mức giá</option>
                            <option value="0-2000000" selected="@(Model.MucGia == "0-2000000")">Dưới 2 triệu</option>
                            <option value="2000000-3000000" selected="@(Model.MucGia == "2000000-3000000")">2 – 3 triệu</option>
                            <option value="3000000-5000000" selected="@(Model.MucGia == "3000000-5000000")">3 – 5 triệu</option>
                            <option value="5000000+" selected="@(Model.MucGia == "5000000+")">Trên 5 triệu</option>
                        </select>
                    </div>

                    <div class="phong-filter__group">
                        <label class="phong-filter__label" for="filterDienTich">Diện tích (m²)</label>
                        <select class="form-select phong-filter__select" id="filterDienTich" name="dienTich">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.DienTich))">Mọi diện tích</option>
                            <option value="0-15" selected="@(Model.DienTich == "0-15")">Dưới 15 m²</option>
                            <option value="15-25" selected="@(Model.DienTich == "15-25")">15 – 25 m²</option>
                            <option value="25-40" selected="@(Model.DienTich == "25-40")">25 – 40 m²</option>
                            <option value="40+" selected="@(Model.DienTich == "40+")">Trên 40 m²</option>
                        </select>
                    </div>

                    <div class="phong-filter__actions">
                        <a asp-controller="PhongTro" asp-action="Index" class="btn btn-outline-secondary phong-filter__btn-clear">
                            Xóa bộ lọc
                        </a>
                        <button type="submit" class="btn btn-primary phong-filter__btn-apply">
                            Áp dụng
                        </button>
                    </div>
                </form>
            </div>
        </aside>

        <!-- Danh sách phòng -->
        <div class="col-lg-9">
            <div class="phong-results__toolbar">
                <h2 class="phong-results__title">
                    Tất cả phòng
                    <span class="phong-results__count">(@soKetQua kết quả)</span>
                </h2>
            </div>

            @if (soKetQua == 0)
            {
                <p class="phong-results__empty text-muted mb-0">Không tìm thấy phòng phù hợp với bộ lọc.</p>
            }
            else
            {
                <div class="row g-4 phong-results__grid">
                    @foreach (var phong in Model.DanhSachPhong)
                    {
                        <div class="col-md-6 col-xl-4">
                            @await Html.PartialAsync("_RoomCard", phong)
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
