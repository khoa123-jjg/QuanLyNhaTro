@model QLNhaTro.Models.PhongTro.PhongTroDetailViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Chi tiết phòng";
    ViewData["ActiveNav"] = "rooms";

    var giaThueHienThi = $"{FormatHelper.FormatGiaThue(Model.GiaThue)}/tháng";
    var dienTichHienThi = FormatHelper.FormatDienTich(Model.DienTich);
    var anhChinh = Model.DanhSachAnh[0];
    var soAnh = Model.DanhSachAnh.Count;
    var isNguoiThue = User.IsInRole("NGUOI_THUE");
    var isKhach = User.Identity?.IsAuthenticated != true;
}

<section class="room-detail-page">
    <div class="container py-4 py-lg-5">
        <div class="row g-4 g-xl-5">
            <div class="col-lg-7">
                <div class="room-gallery">
                    <div class="room-gallery__main">
                        <img class="room-gallery__image" id="roomGalleryMain" src="@anhChinh" alt="@Model.TieuDe" />
                        @if (soAnh > 1)
                        {
                            <button type="button" class="room-gallery__nav room-gallery__nav--left" aria-label="Ảnh trước" data-gallery-prev><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
                            <button type="button" class="room-gallery__nav room-gallery__nav--right" aria-label="Ảnh sau" data-gallery-next><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                        }
                        <div class="room-gallery__count" id="roomGalleryCount">1/@soAnh</div>
                    </div>
                    @if (soAnh > 1)
                    {
                        <div class="room-gallery__thumbs" id="roomGalleryThumbs">
                            @for (var i = 0; i < Model.DanhSachAnh.Count; i++)
                            {
                                var anh = Model.DanhSachAnh[i];
                                <button type="button" class="room-gallery__thumb @(i == 0 ? "is-active" : "")" data-gallery-index="@i" data-gallery-src="@anh" aria-label="Xem ảnh @(i + 1)"><img src="@anh" alt="" /></button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="room-detail-panel">
                    <div class="room-detail-panel__header">
                        <h1 class="room-detail__title">@Model.TieuDe</h1>
                        <div class="room-detail__price">@giaThueHienThi</div>
                        <div class="room-detail__summary"><span>@dienTichHienThi</span><span>@Model.TenNhaTro</span></div>
                    </div>

                    <div class="room-info-grid">
                        <div class="room-info-grid__item"><span class="room-info-grid__label">Diện tích</span><span class="room-info-grid__value">@dienTichHienThi</span></div>
                        <div class="room-info-grid__item"><span class="room-info-grid__label">Nhà trọ</span><span class="room-info-grid__value">@Model.TenNhaTro</span></div>
                        <div class="room-info-grid__item room-info-grid__item--wide"><span class="room-info-grid__label">Khu vực</span><span class="room-info-grid__value">@Model.DiaChi</span></div>
                    </div>

                    @if (Model.TienNghi.Count > 0)
                    {
                        <div class="room-section"><h2 class="room-section__title">Tiện nghi</h2><div class="amenity-tags">@foreach (var tienNghi in Model.TienNghi) { <span class="amenity-tag">@tienNghi</span> }</div></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                    {
                        <div class="room-section"><h2 class="room-section__title">Mô tả phòng</h2><p class="room-description mb-0">@Model.MoTa</p></div>
                    }

                    <div class="room-section">
                        <h2 class="room-section__title">Địa chỉ</h2>
                        <p class="room-address mb-2">@Model.DiaChi</p>
                        @if (Model.ViDo.HasValue && Model.KinhDo.HasValue)
                        {
                            <div id="roomDetailMap" class="room-detail-map" data-lat="@Model.ViDo.Value.ToString(CultureInfo.InvariantCulture)" data-lng="@Model.KinhDo.Value.ToString(CultureInfo.InvariantCulture)" data-title="@Model.TieuDe" data-address="@Model.DiaChi"></div>
                            <a class="room-map-link" asp-controller="PhongTro" asp-action="BanDo" asp-route-id="@Model.PhongTroId">Xem trên bản đồ <i class="bi bi-arrow-right-short" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <div class="room-detail-map-empty">Nhà trọ này chưa có dữ liệu vị trí trên bản đồ.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-0 mt-lg-1">
            @if (!string.IsNullOrWhiteSpace(Model.SoDienThoaiLienHe))
            {
                <div class="col-lg-5 offset-lg-7"><div class="room-contact-box"><h2 class="room-contact-box__title">Liên hệ chủ phòng</h2><div class="room-contact-box__phone">@Model.SoDienThoaiLienHe</div></div></div>
            }

            <div class="col-lg-5 offset-lg-7">
                <div class="room-rent-box">
                    <h2 class="room-rent-box__title">Yêu cầu thuê</h2>
                    @if (!User.Identity?.IsAuthenticated == true)
                    {
                        <div class="room-rent-box__notice">Bạn cần đăng nhập để gửi yêu cầu thuê.</div>
                        <a class="btn btn-primary room-rent-box__login-btn" asp-controller="Account" asp-action="Login">Đăng nhập để gửi yêu cầu</a>
                    }
                    else if (isNguoiThue)
                    {
                        <a class="btn btn-primary room-rent-box__login-btn" asp-controller="YeuCauThue" asp-action="GuiYeuCau" asp-route-phongTroId="@Model.PhongTroId">Gửi yêu cầu thuê</a>
                    }
                    else
                    {
                        <div class="room-rent-box__notice">Chỉ tài khoản người thuê mới có thể gửi yêu cầu thuê.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@if (Model.ViDo.HasValue && Model.KinhDo.HasValue)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mapElement = document.getElementById("roomDetailMap");
            if (!mapElement || typeof L === "undefined") return;
            const lat = Number(mapElement.dataset.lat);
            const lng = Number(mapElement.dataset.lng);
            const title = mapElement.dataset.title || "Phòng trọ";
            const address = mapElement.dataset.address || "";
            const map = L.map("roomDetailMap").setView([lat, lng], 16);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "&copy; OpenStreetMap contributors" }).addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup(`<strong>${title}</strong><br>${address}`).openPopup();
        });
    </script>
}

@if (soAnh > 1)
{
    <script>
        (function () {
            const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachAnh));
            const main = document.getElementById('roomGalleryMain');
            const count = document.getElementById('roomGalleryCount');
            const thumbs = document.querySelectorAll('[data-gallery-index]');
            let current = 0;
            function show(index) {
                current = (index + images.length) % images.length;
                main.src = images[current];
                count.textContent = `${current + 1}/${images.length}`;
                thumbs.forEach((btn, i) => btn.classList.toggle('is-active', i === current));
            }
            document.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
            document.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
            thumbs.forEach(btn => btn.addEventListener('click', () => show(Number(btn.dataset.galleryIndex))));
        })();
    </script>
}
