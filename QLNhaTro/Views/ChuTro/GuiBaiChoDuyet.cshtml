@model QLNhaTro.Models.BaiDang.GuiBaiChoDuyetViewModel
@using QLNhaTro.Helpers.Constants
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Gửi bài chờ duyệt";
    ViewData["ActiveLandlordMenu"] = "BaiDang";

    var coAnhThat = !string.IsNullOrWhiteSpace(Model.AnhDaiDien)
        && Model.AnhDaiDien != DefaultImage.PhongTro;
    var coTieuDe = !string.IsNullOrWhiteSpace(Model.TieuDe) && Model.TieuDe.Trim().Length >= 5;
    var coMoTa = !string.IsNullOrWhiteSpace(Model.NoiDung) && Model.NoiDung.Trim().Length >= 30;
    var coHinhAnh = coAnhThat;
    var coGia = Model.GiaThueThang > 0;
    var coNhaTroDiaChi = !string.IsNullOrWhiteSpace(Model.TenNhaTro)
        && !string.IsNullOrWhiteSpace(Model.DiaChi);
    var coLienHe = !string.IsNullOrWhiteSpace(Model.SoDienThoaiLienHe);
}

<section class="landlord-form-page landlord-submit-review-page">
    <header class="landlord-form-page__header mb-4">
        <h1 class="landlord-page-title">Gửi bài chờ duyệt</h1>
        <p class="landlord-page-subtitle mb-0">Kiểm tra lại thông tin trước khi gửi bài cho hệ thống.</p>
    </header>

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger mb-4" role="alert">@errorMessage</div>
    }

    <div class="submit-review-grid">
        <article class="review-post-card landlord-post-summary-card">
            <h2 class="landlord-panel__title">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                Thông tin bài đăng
            </h2>
            <div class="review-post-card__media landlord-post-summary-card__media">
                @if (coAnhThat)
                {
                    <img src="@Model.AnhDaiDien" alt="Ảnh phòng @Model.MaPhong" />
                }
                else
                {
                    <div class="review-post-card__media-placeholder post-preview-card__media--empty">
                        <i class="bi bi-image" aria-hidden="true"></i>
                    </div>
                }
            </div>
            <h3 class="landlord-post-summary-card__title review-post-card__heading text-safe">@Model.TieuDe</h3>
            <p class="landlord-post-summary-card__price review-post-card__price">@FormatHelper.FormatGiaThue(Model.GiaThueThang)/tháng</p>
            <span class="landlord-badge landlord-badge--info landlord-post-summary-card__room">Phòng @Model.MaPhong</span>

            @if (Model.TienNghi.Count > 0)
            {
                <div class="landlord-post-summary-card__tags mb-4">
                    @foreach (var tienNghi in Model.TienNghi.Take(5))
                    {
                        <span class="landlord-amenity-pill">@tienNghi</span>
                    }
                    @if (Model.TienNghi.Count > 5)
                    {
                        <span class="landlord-amenity-pill landlord-amenity-pill--muted">+@(Model.TienNghi.Count - 5) tiện nghi khác</span>
                    }
                </div>
            }

            <ul class="landlord-post-summary-card__details review-post-card__details list-unstyled mb-4">
                <li>
                    <i class="bi bi-building" aria-hidden="true"></i>
                    <span>Nhà trọ</span>
                    <strong class="text-safe">@Model.TenNhaTro</strong>
                </li>
                <li>
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span>Địa chỉ</span>
                    <strong class="text-safe">@(Model.DiaChi ?? "Chưa cập nhật")</strong>
                </li>
                <li>
                    <i class="bi bi-aspect-ratio" aria-hidden="true"></i>
                    <span>Diện tích</span>
                    <strong>@FormatHelper.FormatDienTich(Model.DienTich)</strong>
                </li>
                <li>
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Số người tối đa</span>
                    <strong>@FormatHelper.FormatSoNguoi(Model.SoNguoiToiDa)</strong>
                </li>
                @if (!string.IsNullOrWhiteSpace(Model.SoDienThoaiLienHe))
                {
                    <li>
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <span>Liên hệ</span>
                        <strong class="text-safe">@Model.SoDienThoaiLienHe</strong>
                    </li>
                }
            </ul>

            <div class="landlord-post-summary-card__desc review-post-card__desc">
                <h4 class="landlord-post-summary-card__desc-title">Mô tả</h4>
                <p class="review-post-card__content text-safe mb-0">@Model.NoiDung</p>
            </div>
        </article>

        <div class="submit-review-grid__aside">
            <div class="review-checklist-card landlord-checklist-card">
                <h2 class="landlord-panel__title">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    Danh sách kiểm tra
                </h2>
                <ul class="landlord-checklist list-unstyled mb-0">
                    <li class="landlord-checklist__item @(coTieuDe ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coTieuDe ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Tiêu đề rõ ràng, dễ hiểu</strong>
                            <span>@(coTieuDe ? "Đã hoàn tất" : "Vui lòng nhập tiêu đề đủ rõ")</span>
                        </div>
                    </li>
                    <li class="landlord-checklist__item @(coMoTa ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coMoTa ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Mô tả đầy đủ, chi tiết</strong>
                            <span>@(coMoTa ? "Đã hoàn tất" : "Vui lòng bổ sung mô tả chi tiết hơn")</span>
                        </div>
                    </li>
                    <li class="landlord-checklist__item @(coHinhAnh ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coHinhAnh ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Hình ảnh hợp lệ, rõ nét</strong>
                            <span>@(coHinhAnh ? "Đã hoàn tất" : "Vui lòng tải ảnh phòng trước khi gửi")</span>
                        </div>
                    </li>
                    <li class="landlord-checklist__item @(coGia ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coGia ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Giá thuê chính xác</strong>
                            <span>@(coGia ? "Đã hoàn tất" : "Vui lòng kiểm tra giá thuê phòng")</span>
                        </div>
                    </li>
                    <li class="landlord-checklist__item @(coNhaTroDiaChi ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coNhaTroDiaChi ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Thông tin nhà trọ, địa chỉ</strong>
                            <span>@(coNhaTroDiaChi ? "Đã hoàn tất" : "Vui lòng kiểm tra địa chỉ nhà trọ")</span>
                        </div>
                    </li>
                    <li class="landlord-checklist__item @(coLienHe ? "landlord-checklist__item--done" : "")">
                        <i class="bi @(coLienHe ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        <div class="landlord-checklist__body">
                            <strong class="text-safe">Thông tin liên hệ đầy đủ</strong>
                            <span>@(coLienHe ? "Đã hoàn tất" : "Vui lòng cập nhật số điện thoại liên hệ")</span>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="landlord-card landlord-approval-notice mb-3">
                <div class="landlord-approval-notice__icon" aria-hidden="true">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="min-width-0">
                    <h3 class="landlord-approval-notice__title">Thời gian duyệt dự kiến</h3>
                    <p class="landlord-approval-notice__text mb-2">
                        Bài đăng của bạn sẽ được hệ thống duyệt trong <strong class="review-approval-hours">2 – 4 giờ</strong>.
                    </p>
                    <p class="landlord-approval-notice__hint mb-0">Bạn sẽ nhận thông báo khi bài đăng được duyệt.</p>
                </div>
            </div>

            <div class="landlord-submit-review-actions submit-review-actions">
                <a class="btn btn-landlord-outline submit-review-actions__back"
                   asp-controller="ChuTro"
                   asp-action="ThemSuaBaiDang"
                   asp-route-id="@Model.Id">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Quay lại chỉnh sửa
                </a>
                <form class="submit-review-actions__form"
                      asp-controller="ChuTro"
                      asp-action="XacNhanGuiBaiChoDuyet"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-landlord-accent submit-review-actions__submit w-100">
                        <i class="bi bi-send" aria-hidden="true"></i>
                        Gửi chờ duyệt
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
