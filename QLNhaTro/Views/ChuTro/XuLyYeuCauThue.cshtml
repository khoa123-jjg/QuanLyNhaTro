@model QLNhaTro.Models.ChuTro.YeuCauThue.ChuTroXuLyYeuCauThueViewModel
@using QLNhaTro.Helpers.Constants
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Xử lý yêu cầu thuê";
    ViewData["ActiveLandlordMenu"] = "YeuCauThue";
    var isProcessed = !YeuCauThueStatus.CoTheXuLy(Model.TrangThaiHienTai);
}

<section class="landlord-form-page landlord-rent-request-process">
    <header class="landlord-page-header mb-4">
        <h1 class="landlord-page-title">Xử lý yêu cầu thuê</h1>
        <p class="landlord-page-subtitle mb-0">Chọn phương án phản hồi rồi lưu cập nhật.</p>
    </header>

    @if (isProcessed)
    {
        <div class="alert alert-warning">Yêu cầu này đã được xử lý.</div>
    }

    <form asp-controller="ChuTro" asp-action="XuLyYeuCauThue" method="post" class="landlord-form landlord-process-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <div class="col-lg-6">
                <label class="landlord-process-choice landlord-process-choice--approve">
                    <input asp-for="TrangThaiXuLy" type="radio" value="@YeuCauThueStatus.ChuTroDongY" data-process-choice="approve" />
                    <span class="landlord-process-choice__content">
                        <strong>Đồng ý yêu cầu</strong>
                        <small>Chấp nhận yêu cầu thuê và có thể ghi chú cho người thuê.</small>
                    </span>
                    <textarea asp-for="GhiChuChuTro" class="form-control mt-3" rows="4" placeholder="Ghi chú cho người thuê (nếu có)"></textarea>
                    <span asp-validation-for="GhiChuChuTro" class="text-danger"></span>
                </label>
            </div>
            <div class="col-lg-6">
                <label class="landlord-process-choice landlord-process-choice--reject">
                    <input asp-for="TrangThaiXuLy" type="radio" value="@YeuCauThueStatus.ChuTroTuChoi" data-process-choice="reject" />
                    <span class="landlord-process-choice__content">
                        <strong>Từ chối yêu cầu</strong>
                        <small>Chọn khi không thể tiếp nhận yêu cầu thuê.</small>
                    </span>
                    <textarea asp-for="LyDoTuChoi" class="form-control mt-3" rows="4" placeholder="Lý do từ chối hoặc tin nhắn gửi người thuê"></textarea>
                    <span asp-validation-for="LyDoTuChoi" class="text-danger"></span>
                </label>
            </div>
        </div>

        <div class="mt-4">
            <span asp-validation-for="TrangThaiXuLy" class="text-danger"></span>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </div>

        <div class="landlord-form-actions mt-4">
            <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="YeuCauThue">Hủy</a>
            <button type="submit" class="btn btn-landlord-primary" @(isProcessed ? "disabled" : null)>Lưu cập nhật</button>
        </div>
    </form>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const radios = document.querySelectorAll('input[name="TrangThaiXuLy"]');
    const rejectReason = document.querySelector('[name="LyDoTuChoi"]');

    function syncRequired() {
        const checked = document.querySelector('input[name="TrangThaiXuLy"]:checked');
        const isReject = checked && checked.value === '@YeuCauThueStatus.ChuTroTuChoi';
        if (rejectReason) rejectReason.required = isReject;
    }

    radios.forEach(r => r.addEventListener('change', syncRequired));
    syncRequired();
});
</script>
