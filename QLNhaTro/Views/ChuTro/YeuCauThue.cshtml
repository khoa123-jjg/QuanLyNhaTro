@model QLNhaTro.Models.ChuTro.YeuCauThue.ChuTroYeuCauThueListPageViewModel
@using QLNhaTro.Helpers.Constants
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Danh sách yêu cầu thuê";
    ViewData["ActiveLandlordMenu"] = "YeuCauThue";
}

<section class="landlord-list-page landlord-rent-request-list">
    <header class="landlord-list-page__header">
        <div class="landlord-list-page__intro">
            <h1 class="landlord-page-title">Danh sách yêu cầu thuê</h1>
            <p class="landlord-page-subtitle mb-0">Theo dõi và xử lý các yêu cầu từ người thuê.</p>
        </div>
    </header>

    <div class="landlord-card landlord-filter-card mb-4">
        <form class="landlord-filter-bar landlord-filter-bar--rent-request" asp-controller="ChuTro" asp-action="YeuCauThue" method="get">
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="trangThaiYeuCau">Trạng thái</label>
                <select class="form-select" id="trangThaiYeuCau" name="trangThai">
                    @foreach (var option in Model.DanhSachTrangThai)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.TrangThai)">@option.Text</option>
                    }
                </select>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="nhaTroYeuCau">Nhà trọ</label>
                <select class="form-select" id="nhaTroYeuCau" name="nhaTroId">
                    <option value="">Tất cả nhà trọ</option>
                    @foreach (var option in Model.DanhSachNhaTro)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.NhaTroId?.ToString())">@option.Text</option>
                    }
                </select>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="sapXepYeuCau">Sắp xếp</label>
                <select class="form-select" id="sapXepYeuCau" name="sapXep">
                    <option value="moi-nhat" selected="@(string.IsNullOrWhiteSpace(Model.SapXep) || Model.SapXep == "moi-nhat")">Mới nhất</option>
                    <option value="cu-nhat" selected="@(Model.SapXep == "cu-nhat")">Cũ nhất</option>
                </select>
            </div>
        </form>
    </div>

    <div class="landlord-card landlord-table-card">
        <div class="landlord-table-wrap">
            <table class="table landlord-data-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">Người thuê</th>
                        <th scope="col">Phòng quan tâm</th>
                        <th scope="col">Ngày gửi</th>
                        <th scope="col">Ngày xem mong muốn</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.YeuCaus.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center py-4">Chưa có yêu cầu thuê nào.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.YeuCaus)
                        {
                            <tr>
                                <td>
                                    <div class="landlord-tenant-cell">
                                        <div>
                                            <p class="landlord-tenant-cell__name mb-0">@item.HoTenNguoiThue</p>
                                            <p class="landlord-tenant-cell__phone mb-0">@item.SoDienThoaiLienHe</p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="landlord-room-interest">
                                        <img class="landlord-room-interest__thumb" src="@(item.AnhDaiDien ?? "/images/phong-mau.jpg")" alt="@item.TenPhong" />
                                        <div>
                                            <p class="landlord-room-interest__code mb-0">@item.MaPhong</p>
                                            <p class="landlord-room-interest__meta mb-0">@item.GiaThueThang.ToString("N0") đ · @item.TenNhaTro</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="landlord-data-table__date">@(item.NgayGui?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td class="landlord-data-table__date">@(item.NgayMuonXemPhong?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td><span class="@YeuCauThueStatus.GetBadgeClass(item.TrangThai)"><i class="bi bi-circle-fill" aria-hidden="true"></i> @item.TrangThaiText</span></td>
                                <td class="text-end">
                                    <div class="landlord-table-actions landlord-table-actions--rent-request">
                                        <a asp-controller="ChuTro" asp-action="ChiTietYeuCauThue" asp-route-id="@item.Id" class="landlord-table-actions__btn landlord-table-actions__btn--view" title="Xem chi tiết"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                        @if (item.CoTheXuLy)
                                        {
                                            <a asp-controller="ChuTro" asp-action="XuLyYeuCauThue" asp-route-id="@item.Id" asp-route-hanhDong="dong-y" class="landlord-table-actions__btn landlord-table-actions__btn--approve" title="Đồng ý yêu cầu"><i class="bi bi-check-lg" aria-hidden="true"></i></a>
                                            <a asp-controller="ChuTro" asp-action="XuLyYeuCauThue" asp-route-id="@item.Id" asp-route-hanhDong="tu-choi" class="landlord-table-actions__btn landlord-table-actions__btn--reject" title="Từ chối yêu cầu"><i class="bi bi-x-lg" aria-hidden="true"></i></a>
                                        }
                                        else
                                        {
                                            <span class="landlord-table-actions__btn landlord-table-actions__btn--approve disabled" title="Đã xử lý"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
                                            <span class="landlord-table-actions__btn landlord-table-actions__btn--reject disabled" title="Đã xử lý"><i class="bi bi-x-lg" aria-hidden="true"></i></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
