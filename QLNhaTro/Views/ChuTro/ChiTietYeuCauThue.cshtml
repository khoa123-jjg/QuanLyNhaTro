@model QLNhaTro.Models.ChuTro.YeuCauThue.ChuTroChiTietYeuCauThueViewModel
@using QLNhaTro.Helpers.Constants
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Chi tiết yêu cầu thuê";
    ViewData["ActiveLandlordMenu"] = "YeuCauThue";
}

<section class="landlord-page">
    <header class="landlord-page-header mb-4">
        <h1 class="landlord-page-title">Chi tiết yêu cầu thuê</h1>
        <p class="landlord-page-subtitle mb-0">Xem thông tin người thuê và nội dung yêu cầu.</p>
    </header>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="landlord-card landlord-info-card mb-3">
                <h2 class="landlord-panel__title">Thông tin người thuê</h2>
                <ul class="landlord-info-list list-unstyled mb-0">
                    <li><span>Họ tên</span><strong>@Model.HoTenNguoiThue</strong></li>
                    <li><span>Số điện thoại</span><strong>@Model.SoDienThoaiLienHe</strong></li>
                    @if (!string.IsNullOrWhiteSpace(Model.EmailNguoiThue))
                    {
                        <li><span>Email</span><strong>@Model.EmailNguoiThue</strong></li>
                    }
                </ul>
            </div>

            <div class="landlord-card landlord-info-card mb-3">
                <h2 class="landlord-panel__title">Thông tin phòng quan tâm</h2>
                <div class="landlord-room-interest landlord-room-interest--large mb-3">
                    <img class="landlord-room-interest__thumb" src="@(Model.AnhDaiDien ?? "/images/phong-mau.jpg")" alt="@Model.TenPhong" />
                    <div>
                        <p class="landlord-room-interest__code mb-1">@Model.MaPhong</p>
                        @if (!string.IsNullOrWhiteSpace(Model.TenPhong))
                        {
                            <p class="landlord-room-interest__price mb-1">@Model.TenPhong</p>
                        }
                        <p class="landlord-room-interest__meta mb-0">@Model.TenNhaTro · @Model.GiaThueThang.ToString("N0") đ/tháng · @Model.DienTich m²</p>
                    </div>
                </div>
                <ul class="landlord-info-list list-unstyled mb-0">
                    <li><span>Địa chỉ</span><strong>@Model.DiaChi</strong></li>
                    @if (Model.SoNguoiToiDa.HasValue)
                    {
                        <li><span>Sức chứa</span><strong>@Model.SoNguoiToiDa người</strong></li>
                    }
                </ul>
            </div>

            <div class="landlord-card landlord-info-card mb-3">
                <h2 class="landlord-panel__title">Lời nhắn của người thuê</h2>
                <p class="landlord-message-box mb-0">@(string.IsNullOrWhiteSpace(Model.LoiNhan) ? "Người thuê chưa để lại lời nhắn." : Model.LoiNhan)</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="landlord-card landlord-status-card sticky-lg-top">
                <h2 class="landlord-panel__title">Trạng thái hiện tại</h2>
                <span class="@YeuCauThueStatus.GetBadgeClass(Model.TrangThai)"><i class="bi bi-circle-fill" aria-hidden="true"></i> @Model.TrangThaiText</span>
                <ul class="landlord-info-list list-unstyled mt-3 mb-0">
                    <li><span>Ngày gửi yêu cầu</span><strong>@Model.NgayGui?.ToString("dd/MM/yyyy HH:mm")</strong></li>
                    <li><span>Ngày muốn xem phòng</span><strong>@Model.NgayMuonXemPhong?.ToString("dd/MM/yyyy")</strong></li>
                </ul>
                @if (Model.CoTheXuLy)
                {
                    <div class="mt-3">
                        <a class="btn btn-landlord-primary w-100" asp-controller="ChuTro" asp-action="XuLyYeuCauThue" asp-route-id="@Model.Id">Xử lý yêu cầu</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="landlord-form-actions mt-4">
        <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="YeuCauThue">Quay lại danh sách</a>
        @if (Model.CoTheXuLy)
        {
            <a class="btn btn-landlord-primary" asp-controller="ChuTro" asp-action="XuLyYeuCauThue" asp-route-id="@Model.Id">Xử lý yêu cầu</a>
        }
    </div>
</section>
