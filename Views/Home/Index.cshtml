@{
    ViewData["Title"] = "Trang chủ";
    ViewData["ActiveNav"] = "home";
}

<!-- Hero + tìm kiếm -->
<section class="home-hero" aria-label="Tìm phòng trọ Đà Nẵng">
    <div class="home-hero__overlay">
        <div class="container home-hero__content">
            <h1 class="home-hero__title">Tìm phòng trọ phù hợp tại Đà Nẵng</h1>
            <p class="home-hero__subtitle">Nhiều lựa chọn – Giá tốt – Thông tin rõ ràng</p>

            <form class="home-search" asp-controller="PhongTro" asp-action="Index" method="get" aria-label="Tìm kiếm phòng trọ">
                <div class="home-search__field">
                    <label class="home-search__label" for="searchKhuVuc">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                        Chọn khu vực
                    </label>
                    <select class="home-search__select form-select" id="searchKhuVuc" name="khuVuc">
                        <option value="" selected>Tất cả quận</option>
                        <option value="lien-chieu">Liên Chiểu</option>
                        <option value="thanh-khe">Thanh Khê</option>
                        <option value="hai-chau">Hải Châu</option>
                        <option value="son-tra">Sơn Trà</option>
                        <option value="ngu-hanh-son">Ngũ Hành Sơn</option>
                        <option value="cam-le">Cẩm Lệ</option>
                    </select>
                </div>
                <div class="home-search__field">
                    <label class="home-search__label" for="searchGia">
                        <i class="bi bi-cash-stack" aria-hidden="true"></i>
                        Mức giá
                    </label>
                    <select class="home-search__select form-select" id="searchGia" name="gia">
                        <option value="" selected>Mọi mức giá</option>
                        <option value="0-2000000">Dưới 2 triệu</option>
                        <option value="2000000-3000000">2 – 3 triệu</option>
                        <option value="3000000-5000000">3 – 5 triệu</option>
                        <option value="5000000+">Trên 5 triệu</option>
                    </select>
                </div>
                <div class="home-search__field">
                    <label class="home-search__label" for="searchDienTich">
                        <i class="bi bi-aspect-ratio" aria-hidden="true"></i>
                        Diện tích (m²)
                    </label>
                    <select class="home-search__select form-select" id="searchDienTich" name="dienTich">
                        <option value="" selected>Mọi diện tích</option>
                        <option value="0-15">Dưới 15 m²</option>
                        <option value="15-25">15 – 25 m²</option>
                        <option value="25-40">25 – 40 m²</option>
                        <option value="40+">Trên 40 m²</option>
                    </select>
                </div>
                <div class="home-search__action">
                    <button type="submit" class="btn-home-search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Phòng nổi bật -->
<section class="home-featured" aria-labelledby="featuredHeading">
    <div class="container">
        <div class="home-featured__header">
            <h2 id="featuredHeading" class="home-featured__title">PHÒNG NỔI BẬT</h2>
            <a class="home-featured__link" asp-controller="PhongTro" asp-action="Index">
                Xem tất cả <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                @await Html.PartialAsync("_RoomCard", (
                    ImageUrl: "https://images.unsplash.com/photo-1502672260266-1c1ef2cd9361?w=600&h=450&fit=crop",
                    Title: "Phòng trọ đường Trần Cao Vân",
                    District: "Thanh Khê",
                    Price: "2.800.000 đ/tháng",
                    Area: "25 m²",
                    Bathroom: "WC riêng",
                    DetailUrl: "/PhongTro/ChiTiet"
                ))
            </div>
            <div class="col-sm-6 col-lg-3">
                @await Html.PartialAsync("_RoomCard", (
                    ImageUrl: "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=600&h=450&fit=crop",
                    Title: "Phòng mới gần ĐH Bách Khoa",
                    District: "Thanh Khê",
                    Price: "3.200.000 đ/tháng",
                    Area: "22 m²",
                    Bathroom: "WC riêng",
                    DetailUrl: "/PhongTro/ChiTiet"
                ))
            </div>
            <div class="col-sm-6 col-lg-3">
                @await Html.PartialAsync("_RoomCard", (
                    ImageUrl: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=600&h=450&fit=crop",
                    Title: "Phòng full nội thất – An Hải Bắc",
                    District: "Sơn Trà",
                    Price: "4.500.000 đ/tháng",
                    Area: "28 m²",
                    Bathroom: "WC riêng",
                    DetailUrl: "/PhongTro/ChiTiet"
                ))
            </div>
            <div class="col-sm-6 col-lg-3">
                @await Html.PartialAsync("_RoomCard", (
                    ImageUrl: "https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=600&h=450&fit=crop",
                    Title: "Phòng gác lửng – Hòa Minh",
                    District: "Liên Chiểu",
                    Price: "2.000.000 đ/tháng",
                    Area: "18 m²",
                    Bathroom: "WC riêng",
                    DetailUrl: "/PhongTro/ChiTiet"
                ))
            </div>
        </div>
    </div>
</section>

<!-- Thống kê -->
<section class="home-stats" aria-label="Thống kê nền tảng">
    <div class="container">
        <div class="row g-4 g-lg-0 home-stats__row">
            <div class="col-6 col-lg">
                <div class="home-stats__item">
                    <div class="home-stats__icon" aria-hidden="true">
                        <i class="bi bi-buildings"></i>
                    </div>
                    <div class="home-stats__text">
                        <strong class="home-stats__value">2.500+</strong>
                        <span class="home-stats__label">Phòng trọ đa dạng</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="home-stats__item">
                    <div class="home-stats__icon" aria-hidden="true">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="home-stats__text">
                        <strong class="home-stats__value">100%</strong>
                        <span class="home-stats__label">Thông tin minh bạch</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="home-stats__item">
                    <div class="home-stats__icon" aria-hidden="true">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="home-stats__text">
                        <strong class="home-stats__value">15.000+</strong>
                        <span class="home-stats__label">Người dùng tin tưởng</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg">
                <div class="home-stats__item">
                    <div class="home-stats__icon" aria-hidden="true">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div class="home-stats__text">
                        <strong class="home-stats__value">Hỗ trợ 24/7</strong>
                        <span class="home-stats__label">Tư vấn tận tâm</span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg">
                <div class="home-stats__item home-stats__item--center-lg">
                    <div class="home-stats__icon" aria-hidden="true">
                        <i class="bi bi-gift-fill"></i>
                    </div>
                    <div class="home-stats__text">
                        <strong class="home-stats__value">Miễn phí</strong>
                        <span class="home-stats__label">Đăng tin &amp; tìm phòng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
