@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Danh sách yêu cầu thuê";
    ViewData["ActiveLandlordMenu"] = "YeuCauThue";
}

<section class="landlord-list-page landlord-rent-request-list">
    <header class="landlord-list-page__header">
        <div class="landlord-list-page__intro">
            <h1 class="landlord-page-title">Danh sách yêu cầu thuê</h1>
            <p class="landlord-page-subtitle mb-0">Theo dõi và xử lý các yêu cầu từ người thuê.</p>
        </div>
    </header>

    <div class="landlord-card landlord-filter-card mb-4">
        <form class="landlord-filter-bar landlord-filter-bar--rent-request" action="#" method="get" novalidate>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="trangThaiYeuCau">Trạng thái</label>
                <select class="form-select" id="trangThaiYeuCau">
                    <option selected>Tất cả trạng thái</option>
                    <option>Mới</option>
                    <option>Đang xử lý</option>
                    <option>Đã đồng ý</option>
                    <option>Đã từ chối</option>
                </select>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="nhaTroYeuCau">Nhà trọ</label>
                <select class="form-select" id="nhaTroYeuCau">
                    <option selected>Tất cả nhà trọ</option>
                    <option>Nhà trọ An Bình</option>
                    <option>Nhà trọ Minh Khang</option>
                    <option>Nhà trọ Hòa Phú</option>
                </select>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="ngayGuiYeuCau">Ngày gửi</label>
                <div class="landlord-input-icon">
                    <i class="bi bi-calendar3 landlord-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="ngayGuiYeuCau" type="text" placeholder="dd/mm/yyyy – dd/mm/yyyy" />
                </div>
            </div>
            <div class="landlord-filter-bar__field landlord-filter-bar__field--search">
                <label class="landlord-form__label" for="searchYeuCau">Tìm kiếm</label>
                <div class="landlord-input-icon">
                    <i class="bi bi-search landlord-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="searchYeuCau" type="search" placeholder="Tên, SĐT, phòng..." />
                </div>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="sapXepYeuCau">Sắp xếp</label>
                <select class="form-select" id="sapXepYeuCau">
                    <option selected>Mới nhất</option>
                    <option>Cũ nhất</option>
                    <option>Trạng thái</option>
                </select>
            </div>
        </form>
    </div>

