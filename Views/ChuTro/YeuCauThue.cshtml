            <div class="landlord-pagination__controls">
                <ul class="pagination mb-0">
                    <li class="page-item disabled">
                        <span class="page-link landlord-pagination__arrow" aria-hidden="true">&lsaquo;</span>
                    </li>
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">1</span>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link landlord-pagination__arrow" aria-hidden="true">&rsaquo;</span>
                    </li>
                </ul>
                <label class="landlord-pagination__per-page mb-0">
                    <span class="visually-hidden">Số dòng mỗi trang</span>
                    <select class="form-select form-select-sm">
                        <option selected>10 / trang</option>
