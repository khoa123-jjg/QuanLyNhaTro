@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Quản lý địa chỉ";
    ViewData["ActiveLandlordMenu"] = "PhongCuThe";
}

<section class="landlord-form-page landlord-address-page">
    <header class="landlord-form-page__header mb-4">
        <h1 class="landlord-page-title">Quản lý địa chỉ</h1>
        <p class="landlord-page-subtitle mb-0">
            Nhập địa chỉ chi tiết và tọa độ để hiển thị vị trí nhà trọ trên bản đồ.
        </p>
    </header>

    <div class="row g-3 g-xl-4 align-items-start">
        <div class="col-lg-7">
            <div class="landlord-card landlord-form-card">
                <form class="landlord-form" action="#" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="tinhThanh">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                            <select class="form-select" id="tinhThanh">
                                <option selected>Đà Nẵng</option>
                                <option>Quảng Nam</option>
                                <option>Huế</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="quanHuyen">Quận/Huyện <span class="text-danger">*</span></label>
                            <select class="form-select" id="quanHuyen">
                                <option selected>Ngũ Hành Sơn</option>
                                <option>Liên Chiểu</option>
                                <option>Hải Châu</option>
                                <option>Sơn Trà</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="phuongXa">Phường/Xã <span class="text-danger">*</span></label>
                            <select class="form-select" id="phuongXa">
                                <option selected>Hòa Hải</option>
                                <option>Hòa Quý</option>
                                <option>Khuê Mỹ</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="duongPho">Đường phố <span class="text-danger">*</span></label>
                            <input class="form-control" id="duongPho" type="text" value="Nguyễn Tất Thành" />
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="soNha">Số nhà</label>
                            <input class="form-control" id="soNha" type="text" value="45" />
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="tenDiaChiChiTiet">Tên nhà trọ/Địa chỉ chi tiết</label>
                            <input class="form-control" id="tenDiaChiChiTiet" type="text" value="Nhà trọ An Bình - gần ĐH FPT" />
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="viDo">Vĩ độ</label>
                            <input class="form-control" id="viDo" type="text" value="16.0544" inputmode="decimal" />
                        </div>
                        <div class="col-md-6">
                            <label class="landlord-form__label" for="kinhDo">Kinh độ</label>
                            <input class="form-control" id="kinhDo" type="text" value="108.2022" inputmode="decimal" />
                        </div>
                    </div>

                    <button type="button" class="btn btn-landlord-outline landlord-address-page__geo-btn mt-3">
                        <i class="bi bi-crosshair" aria-hidden="true"></i>
                        Lấy tọa độ hiện tại
                    </button>
                </form>
            </div>

            <div class="landlord-form-actions">
                <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="ThemSuaNhaTro">Hủy</a>
                <button type="button" class="btn btn-landlord-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    Lưu địa chỉ
                </button>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="landlord-card landlord-map-card mb-3">
                <h2 class="landlord-panel__title">Bản đồ vị trí</h2>
                <div class="landlord-static-map" aria-hidden="true">
                    <div class="landlord-static-map__bg"></div>
                    <div class="landlord-static-map__grid"></div>
                    <span class="landlord-static-map__street landlord-static-map__street--one">Nguyễn Tất Thành</span>
                    <span class="landlord-static-map__street landlord-static-map__street--two">Hòa Hải</span>
                    <span class="landlord-static-map__street landlord-static-map__street--three">Ngũ Hành Sơn</span>
                    <div class="landlord-static-map__marker">
                        <span class="landlord-static-map__pin"></span>
                    </div>
                    <div class="landlord-static-map__popup">
                        <p class="landlord-static-map__popup-title mb-0">Nhà trọ An Bình</p>
                        <p class="landlord-static-map__popup-meta mb-0">16.0544, 108.2022</p>
                    </div>
                    <div class="landlord-static-map__zoom">
                        <button type="button" class="landlord-static-map__zoom-btn" aria-label="Phóng to">+</button>
                        <button type="button" class="landlord-static-map__zoom-btn" aria-label="Thu nhỏ">−</button>
                    </div>
                </div>
            </div>

            <div class="landlord-card landlord-address-summary">
                <h2 class="landlord-panel__title">Địa chỉ đầy đủ</h2>
                <p class="landlord-address-summary__name mb-2">Nhà trọ An Bình - gần ĐH FPT</p>
                <p class="landlord-address-summary__line mb-2">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    45 Nguyễn Tất Thành, Phường Hòa Hải, Quận Ngũ Hành Sơn, TP. Đà Nẵng
                </p>
                <dl class="landlord-address-summary__coords mb-0">
                    <div>
                        <dt>Vĩ độ</dt>
                        <dd>16.0544</dd>
                    </div>
                    <div>
                        <dt>Kinh độ</dt>
                        <dd>108.2022</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</section>
