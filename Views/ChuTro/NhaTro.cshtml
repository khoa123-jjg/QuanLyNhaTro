@model List<QLNhaTro.Models.NhaTro.NhaTroListItemViewModel>
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Danh sách nhà trọ";
    ViewData["ActiveLandlordMenu"] = "NhaTro";
}

<section class="landlord-list-page landlord-nhatro-list">
    <header class="landlord-list-page__header">
        <div class="landlord-list-page__intro">
            <h1 class="landlord-page-title">Danh sách nhà trọ</h1>
            <p class="landlord-page-subtitle mb-0">
                Quản lý các nhà trọ thuộc tài khoản chủ trọ của bạn.
            </p>
        </div>
        <a class="btn btn-landlord-primary" asp-controller="ChuTro" asp-action="ThemSuaNhaTro">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Thêm nhà trọ
        </a>
    </header>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <div class="landlord-card landlord-table-card">
        @if (Model.Count == 0)
        {
            <div class="landlord-empty-state">
                <p class="landlord-empty-state__text mb-0">Bạn chưa có nhà trọ nào.</p>
                <a class="btn btn-landlord-primary btn-sm mt-3" asp-controller="ChuTro" asp-action="ThemSuaNhaTro">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Thêm nhà trọ đầu tiên
                </a>
            </div>
        }
        else
        {
            <div class="landlord-table-wrap">
                <table class="table landlord-data-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Tên nhà trọ</th>
                            <th scope="col">Địa chỉ</th>
                            <th scope="col">Khu vực</th>
                            <th scope="col">Số phòng</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Ngày tạo</th>
                            <th scope="col" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="landlord-data-table__name">@item.TenNhaTro</td>
                                <td>@(string.IsNullOrWhiteSpace(item.DiaChiDayDu) ? "—" : item.DiaChiDayDu)</td>
                                <td>@HienThiKhuVuc(item)</td>
                                <td>@item.SoPhong</td>
                                <td>@Html.Raw(HienThiTrangThai(item.TrangThai))</td>
                                <td class="landlord-data-table__date">@item.NgayTao.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="landlord-table-actions">
                                        <a class="landlord-table-actions__btn landlord-table-actions__btn--view"
                                           href="#"
                                           aria-label="Xem chi tiết @item.TenNhaTro"
                                           title="Xem chi tiết (sắp có)">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                           asp-controller="ChuTro"
                                           asp-action="ThemSuaNhaTro"
                                           asp-route-id="@item.Id"
                                           aria-label="Sửa @item.TenNhaTro">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        </a>
                                        <button type="button"
                                                class="landlord-table-actions__btn landlord-table-actions__btn--delete"
                                                disabled
                                                aria-label="Xóa @item.TenNhaTro"
                                                title="Chức năng xóa sắp có">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="landlord-pagination" aria-label="Tổng số nhà trọ">
                <p class="landlord-pagination__summary mb-0">
                    Hiển thị @Model.Count nhà trọ
                </p>
            </nav>
        }
    </div>
</section>

@functions
{
    private static string HienThiKhuVuc(QLNhaTro.Models.NhaTro.NhaTroListItemViewModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.TenXa) && !string.IsNullOrWhiteSpace(item.TenQuanHuyen))
        {
            return $"{item.TenXa.Trim()}, {item.TenQuanHuyen.Trim()}";
        }

        if (!string.IsNullOrWhiteSpace(item.TenQuanHuyen))
        {
            return item.TenQuanHuyen.Trim();
        }

        if (!string.IsNullOrWhiteSpace(item.TenXa))
        {
            return item.TenXa.Trim();
        }

        return "—";
    }

    private static string HienThiTrangThai(string trangThai) => trangThai switch
    {
        "HOAT_DONG" => """<span class="landlord-badge landlord-badge--success">Đang hoạt động</span>""",
        "TAM_AN" => """<span class="landlord-badge landlord-badge--warning">Tạm ẩn</span>""",
        "NGUNG_HOAT_DONG" => """<span class="landlord-badge landlord-badge--danger">Ngừng hoạt động</span>""",
        _ => $"""<span class="landlord-badge landlord-badge--secondary">{trangThai}</span>"""
    };
}
