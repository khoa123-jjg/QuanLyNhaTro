@{
    Layout = "~/Views/Shared/_LandlordLayout.cshtml";
    ViewData["Title"] = "Danh sách loại phòng";
    ViewData["ActiveLandlordMenu"] = "LoaiPhong";
}

<section class="landlord-list-page landlord-roomtype-list">
    <header class="landlord-list-page__header">
        <div class="landlord-list-page__intro">
            <h1 class="landlord-page-title">Danh sách loại phòng</h1>
            <p class="landlord-page-subtitle mb-0">
                Quản lý và theo dõi các loại phòng trong nhà trọ của bạn.
            </p>
        </div>
        <a class="btn btn-landlord-primary" asp-controller="ChuTro" asp-action="ThemSuaLoaiPhong">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Thêm loại phòng
        </a>
    </header>

    <div class="landlord-card landlord-table-card">
        <div class="landlord-table-wrap">
            <table class="table landlord-data-table mb-0">
                <thead>
                    <tr>
                        <th scope="col">Tên loại phòng</th>
                        <th scope="col">Diện tích</th>
                        <th scope="col">Giá thuê</th>
                        <th scope="col">Tiền cọc</th>
                        <th scope="col">Số người tối đa</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="landlord-data-table__name">Phòng tiêu chuẩn</td>
                        <td>18 m²</td>
                        <td class="landlord-data-table__money">2.500.000 đ</td>
                        <td class="landlord-data-table__money">2.500.000 đ</td>
                        <td>2 người</td>
                        <td><span class="landlord-badge landlord-badge--success">Đang hoạt động</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng tiêu chuẩn">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng tiêu chuẩn">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="landlord-data-table__name">Phòng rộng</td>
                        <td>22 m²</td>
                        <td class="landlord-data-table__money">3.000.000 đ</td>
                        <td class="landlord-data-table__money">3.000.000 đ</td>
                        <td>2 người</td>
                        <td><span class="landlord-badge landlord-badge--success">Đang hoạt động</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng rộng">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng rộng">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="landlord-data-table__name">Phòng có ban công</td>
                        <td>20 m²</td>
                        <td class="landlord-data-table__money">3.200.000 đ</td>
                        <td class="landlord-data-table__money">3.200.000 đ</td>
                        <td>2 người</td>
                        <td><span class="landlord-badge landlord-badge--success">Đang hoạt động</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng có ban công">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng có ban công">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="landlord-data-table__name">Phòng cao cấp</td>
                        <td>25 m²</td>
                        <td class="landlord-data-table__money">4.500.000 đ</td>
                        <td class="landlord-data-table__money">4.500.000 đ</td>
                        <td>2 người</td>
                        <td><span class="landlord-badge landlord-badge--success">Đang hoạt động</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng cao cấp">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng cao cấp">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="landlord-data-table__name">Phòng gác lửng</td>
                        <td>24 m²</td>
                        <td class="landlord-data-table__money">2.800.000 đ</td>
                        <td class="landlord-data-table__money">2.800.000 đ</td>
                        <td>2 người</td>
                        <td><span class="landlord-badge landlord-badge--warning">Tạm ẩn</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng gác lửng">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng gác lửng">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="landlord-data-table__name">Phòng mini</td>
                        <td>14 m²</td>
                        <td class="landlord-data-table__money">2.000.000 đ</td>
                        <td class="landlord-data-table__money">2.000.000 đ</td>
                        <td>1 người</td>
                        <td><span class="landlord-badge landlord-badge--success">Đang hoạt động</span></td>
                        <td class="text-end">
                            <div class="landlord-table-actions">
                                <a class="landlord-table-actions__btn landlord-table-actions__btn--edit"
                                   asp-controller="ChuTro"
                                   asp-action="ThemSuaLoaiPhong"
                                   aria-label="Sửa Phòng mini">
                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                </a>
                                <button type="button" class="landlord-table-actions__btn landlord-table-actions__btn--delete" aria-label="Xóa Phòng mini">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <nav class="landlord-pagination" aria-label="Phân trang danh sách loại phòng">
            <p class="landlord-pagination__summary mb-0">Hiển thị 1–6 / 6 loại phòng</p>
            <ul class="pagination mb-0">
                <li class="page-item disabled">
                    <span class="page-link landlord-pagination__arrow" aria-hidden="true">&lsaquo;</span>
                </li>
                <li class="page-item active" aria-current="page">
                    <span class="page-link">1</span>
                </li>
                <li class="page-item disabled">
                    <span class="page-link landlord-pagination__arrow" aria-hidden="true">&rsaquo;</span>
                </li>
            </ul>
        </nav>
    </div>
</section>
