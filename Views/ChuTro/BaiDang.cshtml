@{
    Layout = "~/Views/Shared/_LandlordLayout.cshtml";
    ViewData["Title"] = "Danh sách bài đăng";
    ViewData["ActiveLandlordMenu"] = "BaiDang";
}

<section class="landlord-list-page landlord-post-list">
    <header class="landlord-list-page__header">
        <div class="landlord-list-page__intro">
            <h1 class="landlord-page-title">Danh sách bài đăng</h1>
            <p class="landlord-page-subtitle mb-0">Quản lý bài đăng cho thuê của bạn.</p>
        </div>
    </header>

    <div class="landlord-card landlord-filter-card mb-4">
        <form class="landlord-filter-bar" action="#" method="get" novalidate>
            <div class="landlord-filter-bar__field landlord-filter-bar__field--search">
                <label class="landlord-form__label" for="searchBaiDang">Tìm kiếm</label>
                <div class="landlord-input-icon">
                    <i class="bi bi-search landlord-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="searchBaiDang" type="search" placeholder="Tìm kiếm bài đăng theo tiêu đề..." />
                </div>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="nhaTroFilter">Nhà trọ</label>
                <select class="form-select" id="nhaTroFilter">
                    <option selected>Tất cả nhà trọ</option>
                    <option>Nhà trọ An Bình</option>
                    <option>Nhà trọ Minh Khang</option>
                    <option>Nhà trọ Hòa Phú</option>
                </select>
            </div>
            <div class="landlord-filter-bar__field">
                <label class="landlord-form__label" for="trangThaiDuyetFilter">Trạng thái duyệt</label>
                <select class="form-select" id="trangThaiDuyetFilter">
                    <option selected>Tất cả trạng thái</option>
                    <option>Đã duyệt</option>
                    <option>Chờ duyệt</option>
                    <option>Nháp</option>
                    <option>Bị từ chối</option>
                </select>
            </div>
            <div class="landlord-filter-bar__action">
                <span class="landlord-form__label landlord-filter-bar__action-label" aria-hidden="true">&nbsp;</span>
                <a class="btn btn-landlord-accent" asp-controller="ChuTro" asp-action="ThemSuaBaiDang">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Tạo bài đăng mới
                </a>
            </div>
        </form>
    </div>

