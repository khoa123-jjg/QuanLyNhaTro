@model QuanLyNhaTro.Models.TienNghi.TienNghiPhongPageViewModel
@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Gắn tiện nghi cho phòng";
    ViewData["ActiveLandlordMenu"] = "TienNghi";
    var daChonCount = Model.TienNghiDaChon.Count;
    var coPhong = Model.PhongTroIdDangChon is > 0;
    var nhanPhongDangChon = coPhong
        ? Model.DanhSachPhong.FirstOrDefault(p => p.Value == Model.PhongTroIdDangChon!.Value.ToString())?.Text
        : null;
}

<section class="landlord-amenity-page">
    <header class="landlord-form-page__header mb-4">
        <h1 class="landlord-page-title">Gắn tiện nghi cho phòng</h1>
        <p class="landlord-page-subtitle mb-0">
            Chọn phòng và đánh dấu các tiện nghi áp dụng (lưu gán sẽ được bổ sung sau).
        </p>
    </header>

    @if (Model.DanhSachPhong.Count == 0)
    {
        <div class="alert alert-info mb-4" role="status">Bạn chưa có phòng nào. Hãy thêm phòng trước khi gán tiện nghi.</div>
    }
    else if (!coPhong)
    {
        <div class="alert alert-info mb-4" role="status">Vui lòng chọn phòng.</div>
    }

    @if (Model.DanhSachPhong.Count > 0)
    {
        <form method="get" asp-controller="ChuTro" asp-action="TienNghi" class="landlord-card mb-4">
            <label class="form-label fw-semibold" for="phongTroId">Chọn phòng</label>
            <div class="row g-2 align-items-end">
                <div class="col-md-8 col-lg-6">
                    <select class="form-select" id="phongTroId" name="phongTroId" asp-for="PhongTroIdDangChon" asp-items="Model.DanhSachPhong">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-landlord-primary">
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                        Áp dụng
                    </button>
                </div>
            </div>
        </form>
    }

    @if (coPhong && !string.IsNullOrEmpty(nhanPhongDangChon))
    {
        <div class="landlord-card landlord-selected-roomtype mb-4">
            <div class="landlord-selected-roomtype__icon" aria-hidden="true">
                <i class="bi bi-door-closed"></i>
            </div>
            <div class="landlord-selected-roomtype__body">
                <p class="landlord-selected-roomtype__label mb-1">Phòng đang chọn</p>
                <h2 class="landlord-selected-roomtype__name mb-2">@nhanPhongDangChon</h2>
            </div>
        </div>

        <div class="row g-3 g-xl-4">
            <div class="col-lg-6">
                <div class="landlord-card landlord-amenity-panel h-100">
                    <h2 class="landlord-panel__title">Danh sách tiện nghi</h2>
                    @if (Model.DanhSachTienNghi.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có tiện nghi nào đang hiển thị.</p>
                    }
                    else
                    {
                        <ul class="landlord-amenity-list list-unstyled mb-0">
                            @foreach (var item in Model.DanhSachTienNghi)
                            {
                                <li class="landlord-amenity-list__item">
                                    <label class="landlord-amenity-check">
                                        <input type="checkbox" disabled @(item.DaChon ? "checked" : null) />
                                        <span class="landlord-amenity-check__box" aria-hidden="true"></span>
                                        <i class="@item.Icon landlord-amenity-check__icon" aria-hidden="true"></i>
                                        <span>@item.TenTienNghi</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="landlord-card landlord-amenity-panel landlord-amenity-panel--selected h-100">
                    <h2 class="landlord-panel__title">
                        Tiện nghi đã chọn
                        <span class="landlord-amenity-panel__count">@daChonCount</span>
                    </h2>
                    @if (daChonCount == 0)
                    {
                        <p class="text-muted mb-0">Chưa gán tiện nghi cho phòng này.</p>
                    }
                    else
                    {
                        <ul class="landlord-amenity-selected list-unstyled mb-0">
                            @foreach (var item in Model.TienNghiDaChon)
                            {
                                <li class="landlord-amenity-selected__item">
                                    <i class="@item.Icon" aria-hidden="true"></i>
                                    <span>@item.TenTienNghi</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }

    <div class="landlord-form-actions mt-4">
        <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="NhaTro">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Quay lại
        </a>
        @if (coPhong)
        {
            <button type="button" class="btn btn-landlord-primary" disabled title="Chức năng lưu sẽ được bổ sung sau">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                Lưu tiện nghi
            </button>
        }
    </div>
</section>
