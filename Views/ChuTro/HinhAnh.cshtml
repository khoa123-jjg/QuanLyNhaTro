@{
    Layout = "~/Views/Shared/_ChuTroLayout.cshtml";
    ViewData["Title"] = "Quản lý hình ảnh";
    ViewData["ActiveLandlordMenu"] = "HinhAnh";

    var sampleImages = new[]
    {
        "https://images.unsplash.com/photo-1560448204-e02f11c45772?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1560185127-6ed189bf02f4?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1484154218962-a197022b5858?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=600&h=450&fit=crop",
        "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=600&h=450&fit=crop"
    };
}

<section class="landlord-image-page">
    <header class="landlord-form-page__header mb-4">
        <h1 class="landlord-page-title">Quản lý hình ảnh</h1>
        <p class="landlord-page-subtitle mb-0">
            Sắp xếp, đặt ảnh bìa và quản lý thư viện ảnh cho loại phòng.
        </p>
    </header>

    <div class="landlord-card landlord-selected-roomtype landlord-selected-roomtype--with-action mb-4">
        <div class="landlord-selected-roomtype__icon" aria-hidden="true">
            <i class="bi bi-images"></i>
        </div>
        <div class="landlord-selected-roomtype__body">
            <p class="landlord-selected-roomtype__label mb-1">Loại phòng đang chọn</p>
            <h2 class="landlord-selected-roomtype__name mb-2">Phòng có ban công</h2>
            <ul class="landlord-selected-roomtype__meta list-unstyled mb-0">
                <li><i class="bi bi-aspect-ratio" aria-hidden="true"></i> Diện tích 25 m²</li>
                <li><i class="bi bi-people" aria-hidden="true"></i> Sức chứa 2 người</li>
            </ul>
        </div>
        <a class="btn btn-landlord-outline btn-sm landlord-selected-roomtype__change" asp-controller="ChuTro" asp-action="NhaTro">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            Đổi loại phòng
        </a>
    </div>

    <div class="row g-3 g-xl-4 align-items-start">
        <div class="col-xl-8">
            <div class="landlord-card landlord-image-grid-card mb-3">
                <h2 class="landlord-panel__title">Danh sách hình ảnh</h2>
                <div class="row g-3 landlord-image-grid">
                    @for (var i = 0; i < sampleImages.Length; i++)
                    {
                        var order = i + 1;
                        var isCover = i == 0;
                        <div class="col-6 col-md-3">
                            <article class="landlord-image-item @(isCover ? "landlord-image-item--cover" : "")">
                                <img src="@sampleImages[i]" alt="Ảnh phòng @(order)" />
                                <span class="landlord-image-item__order">@order</span>
                                @if (isCover)
                                {
                                    <span class="landlord-image-item__cover-badge">Ảnh bìa</span>
                                }
                                <div class="landlord-image-item__toolbar">
                                    <button type="button" class="landlord-image-item__btn" aria-label="Kéo thả ảnh @order">
                                        <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="landlord-image-item__btn landlord-image-item__btn--delete" aria-label="Xóa ảnh @order">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </div>

            <div class="landlord-card landlord-image-upload">
                <div class="landlord-image-upload__inner">
                    <i class="bi bi-cloud-arrow-up landlord-image-upload__icon" aria-hidden="true"></i>
                    <p class="landlord-image-upload__title mb-1">Kéo thả ảnh vào đây hoặc <button type="button" class="landlord-image-upload__link">Chọn ảnh từ máy</button></p>
                    <p class="landlord-image-upload__hint mb-0">
                        Hỗ trợ JPG, JPEG, PNG, WebP · Tối đa 5MB/ảnh · Tối đa 20 ảnh
                    </p>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="landlord-card landlord-image-settings sticky-lg-top">
                <h2 class="landlord-panel__title">Cài đặt hình ảnh</h2>
                <ul class="landlord-image-settings__list list-unstyled mb-0">
                    <li class="landlord-image-settings__item">
                        <label class="landlord-image-settings__check">
                            <input type="checkbox" checked />
                            <span>Đặt làm ảnh bìa</span>
                        </label>
                        <p class="landlord-image-settings__desc mb-0">Ảnh đầu tiên hiển thị trên bài đăng và danh sách.</p>
                    </li>
                    <li class="landlord-image-settings__item">
                        <label class="landlord-image-settings__check">
                            <input type="checkbox" checked />
                            <span>Hiển thị thứ tự</span>
                        </label>
                        <p class="landlord-image-settings__desc mb-0">Sắp xếp ảnh theo thứ tự bạn chọn.</p>
                    </li>
                    <li class="landlord-image-settings__item">
                        <label class="landlord-image-settings__check">
                            <input type="checkbox" checked />
                            <span>Hiển thị số thứ tự trên ảnh</span>
                        </label>
                        <p class="landlord-image-settings__desc mb-0">Hiện số 1, 2, 3… góc ảnh để dễ quản lý.</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="landlord-form-actions mt-4">
        <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="NhaTro">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Quay lại
        </a>
        <button type="button" class="btn btn-landlord-primary">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            Lưu hình ảnh
        </button>
    </div>
</section>
