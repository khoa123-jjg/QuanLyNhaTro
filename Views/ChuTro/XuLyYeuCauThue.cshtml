@{
    Layout = "~/Views/Shared/_LandlordLayout.cshtml";
    ViewData["Title"] = "Đồng ý / Từ chối yêu cầu thuê";
    ViewData["ActiveLandlordMenu"] = "YeuCauThue";
}

<section class="landlord-form-page landlord-rent-request-process">
    <header class="landlord-form-page__header mb-4">
        <h1 class="landlord-page-title">Đồng ý / Từ chối yêu cầu thuê</h1>
        <p class="landlord-page-subtitle mb-0">Chọn trạng thái xử lý và gửi thông tin phản hồi cho người thuê.</p>
    </header>

    <article class="landlord-card landlord-rent-request-summary mb-4">
        <h2 class="landlord-panel__title">Thông tin tóm tắt</h2>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <p class="landlord-rent-request-summary__label mb-1">Người thuê</p>
                <p class="landlord-rent-request-summary__value mb-0">Nguyễn Văn B · 0905 111 222</p>
            </div>
            <div class="col-sm-6 col-lg-3">
                <p class="landlord-rent-request-summary__label mb-1">Phòng quan tâm</p>
                <p class="landlord-rent-request-summary__value mb-0">P101 · Nhà trọ An Bình</p>
            </div>
            <div class="col-sm-6 col-lg-3">
                <p class="landlord-rent-request-summary__label mb-1">Ngày gửi yêu cầu</p>
                <p class="landlord-rent-request-summary__value mb-0">18/05/2025 09:12</p>
            </div>
            <div class="col-sm-6 col-lg-3">
                <p class="landlord-rent-request-summary__label mb-1">Trạng thái hiện tại</p>
                <span class="landlord-badge landlord-badge--info"><i class="bi bi-circle-fill" aria-hidden="true"></i> Mới</span>
            </div>
        </div>
    </article>

    <form class="landlord-process-form" action="#" method="post" novalidate>
        <h2 class="landlord-process-form__heading">Chọn trạng thái xử lý</h2>

        <div class="row g-3 g-xl-4">
            <div class="col-lg-6">
                <label class="landlord-process-choice landlord-process-choice--approve">
                    <input type="radio" name="trangThaiXuLy" value="approve" checked />
                    <span class="landlord-process-choice__head">
                        <span class="landlord-process-choice__icon landlord-process-choice__icon--approve" aria-hidden="true">
                            <i class="bi bi-check-lg"></i>
                        </span>
                        <span>
                            <strong>Đồng ý yêu cầu</strong>
                            <small>Đặt lịch xem phòng và gửi ghi chú cho người thuê</small>
                        </span>
                    </span>
                    <span class="landlord-process-choice__body">
                        <div class="mb-3">
                            <label class="landlord-form__label" for="ngayHenXem">Ngày hẹn xem phòng <span class="text-danger">*</span></label>
                            <div class="landlord-input-icon">
                                <i class="bi bi-calendar3 landlord-input-icon__icon" aria-hidden="true"></i>
                                <input class="form-control" id="ngayHenXem" type="text" value="20/05/2025" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="landlord-form__label" for="gioHenXem">Giờ hẹn <span class="text-danger">*</span></label>
                            <div class="landlord-input-icon">
                                <i class="bi bi-clock landlord-input-icon__icon" aria-hidden="true"></i>
                                <input class="form-control" id="gioHenXem" type="text" value="14:00" />
                            </div>
                        </div>
                        <div class="mb-0">
                            <label class="landlord-form__label" for="ghiChuDongY">Ghi chú cho người thuê</label>
                            <textarea class="form-control" id="ghiChuDongY" rows="3" placeholder="VD: Vui lòng mang CMND/CCCD khi đến xem phòng.">Anh/chị vui lòng đến đúng giờ, liên hệ trước 30 phút nếu đến trễ.</textarea>
                        </div>
                    </span>
                </label>
            </div>

            <div class="col-lg-6">
                <label class="landlord-process-choice landlord-process-choice--reject">
                    <input type="radio" name="trangThaiXuLy" value="reject" />
                    <span class="landlord-process-choice__head">
                        <span class="landlord-process-choice__icon landlord-process-choice__icon--reject" aria-hidden="true">
                            <i class="bi bi-x-lg"></i>
                        </span>
                        <span>
                            <strong>Từ chối yêu cầu</strong>
                            <small>Nêu lý do và gửi tin nhắn phản hồi</small>
                        </span>
                    </span>
                    <span class="landlord-process-choice__body">
                        <div class="mb-3">
                            <label class="landlord-form__label" for="lyDoTuChoi">Lý do từ chối <span class="text-danger">*</span></label>
                            <select class="form-select" id="lyDoTuChoi">
                                <option selected>Phòng đã có người đặt cọc</option>
                                <option>Không phù hợp đối tượng thuê</option>
                                <option>Thông tin yêu cầu chưa đầy đủ</option>
                                <option>Lý do khác</option>
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="landlord-form__label" for="tinNhanTuChoi">Tin nhắn gửi người thuê</label>
                            <textarea class="form-control" id="tinNhanTuChoi" rows="3" placeholder="Nhập nội dung phản hồi...">Rất tiếc hiện phòng P101 đã có người đặt cọc. Anh/chị có thể xem thêm các phòng tương tự tại nhà trọ An Bình.</textarea>
                        </div>
                    </span>
                </label>
            </div>
        </div>

        <div class="landlord-form-actions">
            <a class="btn btn-landlord-outline" asp-controller="ChuTro" asp-action="ChiTietYeuCauThue">Hủy</a>
            <button type="button" class="btn btn-landlord-primary">
                <i class="bi bi-save" aria-hidden="true"></i>
                Lưu cập nhật
            </button>
        </div>
    </form>
</section>
