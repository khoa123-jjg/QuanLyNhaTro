@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["ActiveAdminMenu"] = "NguoiDung";
}

<section class="admin-page admin-list-page admin-user-list">
    <header class="admin-page-header">
        <h1 class="admin-page-title">Quản lý người dùng</h1>
        <p class="admin-page-subtitle mb-0">Xem danh sách, tìm kiếm người dùng</p>
