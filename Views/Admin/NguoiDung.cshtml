    <div class="admin-card admin-filter-card mb-4">
        <form class="admin-filter-bar" action="#" method="get" novalidate>
            <div class="admin-filter-bar__field admin-filter-bar__field--search">
                <label class="admin-form__label" for="searchNguoiDung">Tìm kiếm</label>
                <div class="admin-input-icon">
                    <i class="bi bi-search admin-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="searchNguoiDung" type="search" placeholder="Tìm kiếm theo tên, email, SĐT..." />
                </div>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="vaiTroFilter">Vai trò</label>
                <select class="form-select admin-filter-select" id="vaiTroFilter">
                    <option selected>Vai trò: Tất cả</option>
                    <option>Admin</option>
                    <option>Chủ trọ</option>
                    <option>Người thuê</option>
                </select>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="trangThaiFilter">Trạng thái</label>
                <select class="form-select admin-filter-select" id="trangThaiFilter">
                    <option selected>Trạng thái: Tất cả</option>
                    <option>Hoạt động</option>
                    <option>Bị khóa</option>
                </select>
            </div>
            <div class="admin-filter-bar__action">
                <span class="admin-form__label admin-filter-bar__action-label" aria-hidden="true">&nbsp;</span>
                <button type="button" class="btn btn-admin-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Thêm người dùng
                </button>
            </div>
        </form>
    </div>

