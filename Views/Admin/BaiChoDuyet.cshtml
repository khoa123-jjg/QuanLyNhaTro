@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý bài chờ duyệt";
    ViewData["ActiveAdminMenu"] = "BaiChoDuyet";
}

<section class="admin-page admin-list-page admin-post-pending-list">
    <header class="admin-page-header">
        <h1 class="admin-page-title">Quản lý bài chờ duyệt</h1>
        <p class="admin-page-subtitle mb-0">Danh sách bài ở trạng thái chờ duyệt</p>
    </header>

    <div class="admin-card admin-filter-card mb-4">
        <form class="admin-filter-bar admin-filter-bar--post" action="#" method="get" novalidate>
            <div class="admin-filter-bar__field admin-filter-bar__field--search">
                <label class="admin-form__label" for="searchBaiChoDuyet">Tìm kiếm</label>
                <div class="admin-input-icon">
                    <i class="bi bi-search admin-input-icon__icon" aria-hidden="true"></i>
                    <input class="form-control" id="searchBaiChoDuyet" type="search" placeholder="Tìm kiếm theo tiêu đề, chủ trọ, nhà trọ..." />
                </div>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="chuTroFilter">Chủ trọ</label>
                <select class="form-select admin-filter-select" id="chuTroFilter">
                    <option selected>Chủ trọ: Tất cả</option>
                    <option>Nguyễn Văn A</option>
                    <option>Trần Thị B</option>
                    <option>Lê Văn C</option>
                </select>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="nhaTroFilter">Nhà trọ</label>
                <select class="form-select admin-filter-select" id="nhaTroFilter">
                    <option selected>Nhà trọ: Tất cả</option>
                    <option>Nhà trọ An Bình</option>
                    <option>Nhà trọ Minh Khang</option>
                    <option>Nhà trọ Hòa Phú</option>
                </select>
            </div>
            <div class="admin-filter-bar__field">
                <label class="admin-form__label" for="trangThaiBaiFilter">Trạng thái</label>
                <select class="form-select admin-filter-select" id="trangThaiBaiFilter">
                    <option selected>Trạng thái: Chờ duyệt</option>
                    <option>Đã duyệt</option>
                    <option>Bị từ chối</option>
                </select>
            </div>
        </form>
    </div>

    <article class="admin-card admin-table-card">
        <div class="admin-table-wrap">
            <table class="table admin-data-table mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="admin-data-table__col-stt">STT</th>
                        <th scope="col">Tiêu đề</th>
                        <th scope="col">Chủ trọ</th>
                        <th scope="col">Nhà trọ</th>
                        <th scope="col">Ngày gửi</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>
                            <div class="admin-table-post">
                                <img class="admin-table-post__thumb" src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=80&h=80&fit=crop" alt="" />
                                <span>Phòng trọ mới đường Lê Duẩn</span>
                            </div>
                        </td>
                        <td>Nguyễn Văn A</td>
                        <td>Nhà trọ An Bình</td>
