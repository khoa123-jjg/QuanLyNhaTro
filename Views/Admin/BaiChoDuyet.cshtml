        <div class="admin-pagination-bar admin-pagination-bar--bordered">
            <p class="admin-pagination-bar__summary mb-0">Hiển thị 1 - 7 của 124 bài</p>
            <nav aria-label="Phân trang bài chờ duyệt">
                <ul class="admin-pagination">
                    <li><span class="admin-pagination__link" aria-hidden="true">&lsaquo;</span></li>
                    <li><span class="admin-pagination__link is-active">1</span></li>
                    <li><a class="admin-pagination__link" href="#">2</a></li>
