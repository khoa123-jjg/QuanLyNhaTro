                        <td class="text-end">
                            <a class="admin-action-btn" asp-controller="Admin" asp-action="ChiTietBaiChoDuyet" aria-label="Xem chi tiết"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        </td>
