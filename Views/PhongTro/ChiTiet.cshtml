@{
    ViewData["Title"] = "Chi tiết phòng";
    ViewData["ActiveNav"] = "rooms";
}

<section class="room-detail-page">
    <div class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb" class="room-breadcrumb mb-4">
            <ol class="breadcrumb mb-0 room-breadcrumb__list">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/PhongTro">Tìm phòng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết phòng</li>
            </ol>
        </nav>

        <div class="row g-4 g-xl-5">
            <div class="col-lg-7">
                <div class="room-gallery">
                    <div class="room-gallery__main">
                        <img class="room-gallery__image" src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=1200&h=800&fit=crop" alt="Phòng gác lửng Hòa Minh" />

                        <button type="button" class="room-gallery__nav room-gallery__nav--left" aria-label="Ảnh trước">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="room-gallery__nav room-gallery__nav--right" aria-label="Ảnh sau">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>

                        <button type="button" class="room-gallery__favorite" aria-label="Yêu thích">
                            <i class="bi bi-heart" aria-hidden="true"></i>
                        </button>

                        <div class="room-gallery__count">1/6</div>
                    </div>

                    <div class="room-gallery__thumbs" aria-hidden="true">
                        <button type="button" class="room-gallery__thumb is-active">
                            <img src="https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=300&h=220&fit=crop" alt="" />
                        </button>
                        <button type="button" class="room-gallery__thumb">
                            <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=300&h=220&fit=crop" alt="" />
                        </button>
                        <button type="button" class="room-gallery__thumb">
                            <img src="https://images.unsplash.com/photo-1502672260266-1c1ef2cd9361?w=300&h=220&fit=crop" alt="" />
                        </button>
                        <button type="button" class="room-gallery__thumb">
                            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=300&h=220&fit=crop" alt="" />
                        </button>
                        <button type="button" class="room-gallery__thumb">
                            <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?w=300&h=220&fit=crop" alt="" />
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="room-detail-panel">
                    <div class="room-detail-panel__header">
                        <h1 class="room-detail__title">Phòng gác lửng – Hòa Minh</h1>
                        <div class="room-detail__price">2.000.000 đ/tháng</div>
                        <div class="room-detail__summary">
                            <span>18 m²</span>
                            <span>Tầng 2</span>
                            <span>Quận Liên Chiểu</span>
                        </div>
                    </div>

                    <div class="room-info-grid">
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Diện tích</span>
                            <span class="room-info-grid__value">18 m²</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Khu vực</span>
                            <span class="room-info-grid__value">Hòa Minh, Liên Chiểu</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Tầng</span>
                            <span class="room-info-grid__value">Tầng 2</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Phòng tắm</span>
                            <span class="room-info-grid__value">Khép kín</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Tiền cọc</span>
                            <span class="room-info-grid__value">2.000.000 đ</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Điện</span>
                            <span class="room-info-grid__value">3.500 đ/kWh</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Nước</span>
                            <span class="room-info-grid__value">80.000 đ/người</span>
                        </div>
                        <div class="room-info-grid__item">
                            <span class="room-info-grid__label">Internet</span>
                            <span class="room-info-grid__value">Miễn phí</span>
                        </div>
                    </div>

                    <div class="room-section">
                        <h2 class="room-section__title">Tiện nghi</h2>
                        <div class="amenity-tags">
                            <span class="amenity-tag">Máy lạnh</span>
                            <span class="amenity-tag">Wifi</span>
                            <span class="amenity-tag">Nóng lạnh</span>
                            <span class="amenity-tag">Camera</span>
                            <span class="amenity-tag">Kệ bếp</span>
                            <span class="amenity-tag">Máy giặt</span>
                            <span class="amenity-tag">Tủ quần áo</span>
                            <span class="amenity-tag">Ban công</span>
                        </div>
                    </div>

                    <div class="room-section">
                        <h2 class="room-section__title">Mô tả phòng</h2>
                        <p class="room-description mb-0">
                            Phòng gác lửng sạch đẹp, thoáng mát, phù hợp cho sinh viên và nhân viên văn phòng.
                            Không gian được bố trí hợp lý với khu sinh hoạt riêng, bếp nhỏ tiện nấu ăn và nhà tắm khép kín.
                            Khu vực an ninh, yên tĩnh, gần chợ, siêu thị, trường học và các tuyến đường lớn nên di chuyển rất thuận tiện.
                            Chủ nhà thân thiện, hỗ trợ tận tâm, vào ở được ngay.
                        </p>
                    </div>

                    <div class="room-section">
                        <h2 class="room-section__title">Địa chỉ</h2>
                        <p class="room-address mb-2">Đường Tôn Đức Thắng, Hòa Minh, Liên Chiểu, Đà Nẵng</p>
                        <a class="room-map-link" href="/PhongTro/BanDo">
                            Xem trên bản đồ <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-0 mt-lg-1">
            <div class="col-lg-5 offset-lg-7">
                <div class="room-contact-box">
                    <h2 class="room-contact-box__title">Liên hệ chủ phòng</h2>
                    <div class="room-contact-box__phone">0901 234 567</div>
                    <div class="room-contact-box__note">Thời gian liên hệ: 7:00 - 21:00</div>
                </div>
            </div>

            <div class="col-lg-5 offset-lg-7">
                <div class="room-rent-box">
                    <h2 class="room-rent-box__title">Yêu cầu thuê</h2>
                    <div class="room-rent-box__notice">Bạn cần đăng nhập để gửi yêu cầu thuê.</div>
                    <a class="btn btn-primary room-rent-box__login-btn" href="/Account/Login">Đăng nhập để gửi yêu cầu</a>
                    <div class="room-rent-box__register">
                        Chưa có tài khoản?
                        <a href="/Account/Register">Đăng ký ngay</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="room-commitment mt-4">
            <div class="room-commitment__item"><i class="bi bi-check2-circle" aria-hidden="true"></i> Miễn phí xem phòng</div>
            <div class="room-commitment__item"><i class="bi bi-check2-circle" aria-hidden="true"></i> Thông tin minh bạch</div>
            <div class="room-commitment__item"><i class="bi bi-check2-circle" aria-hidden="true"></i> Hỗ trợ tận tâm</div>
            <div class="room-commitment__item"><i class="bi bi-check2-circle" aria-hidden="true"></i> An tâm tuyệt đối</div>
        </div>
    </div>
</section>
