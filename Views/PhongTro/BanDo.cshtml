@{
    ViewData["Title"] = "Bản đồ vị trí";
    ViewData["ActiveNav"] = "rooms";
}

<section class="map-page">
    <div class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb" class="map-breadcrumb mb-4">
            <ol class="breadcrumb mb-0 map-breadcrumb__list">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bản đồ vị trí</li>
            </ol>
        </nav>

        <div class="map-page__header mb-4 mb-lg-5">
            <h1 class="map-page__title">BẢN ĐỒ VỊ TRÍ</h1>
            <p class="map-page__desc mb-0">Khám phá vị trí phòng trọ và các tiện ích xung quanh tại Đà Nẵng.</p>
        </div>

        <div class="row g-4 g-xl-5">
            <div class="col-xl-8">
                <div class="map-canvas-card">
                    <div class="map-canvas-card__toolbar">
                        <div class="map-search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="text" class="form-control map-search__input" placeholder="Tìm kiếm khu vực, đường, địa điểm..." aria-label="Tìm kiếm khu vực, đường, địa điểm..." />
                        </div>
                        <button type="button" class="btn map-filter-btn">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            Bộ lọc
                        </button>
                    </div>

                    <div class="map-stage">
                        <div class="map-stage__bg"></div>
                        <div class="map-stage__grid"></div>
                        <div class="map-stage__street map-stage__street--one">Tôn Đức Thắng</div>
                        <div class="map-stage__street map-stage__street--two">Liên Chiểu</div>
                        <div class="map-stage__street map-stage__street--three">Hòa Minh</div>

                        <span class="map-marker map-marker--blue" style="top: 23%; left: 24%;"></span>
                        <span class="map-marker map-marker--blue" style="top: 39%; left: 38%;"></span>
                        <span class="map-marker map-marker--blue" style="top: 56%; left: 18%;"></span>
                        <span class="map-marker map-marker--blue" style="top: 67%; left: 67%;"></span>
                        <span class="map-marker map-marker--blue" style="top: 28%; left: 70%;"></span>
                        <span class="map-marker map-marker--blue" style="top: 72%; left: 33%;"></span>

                        <div class="map-marker map-marker--orange" style="top: 48%; left: 53%;">
                            <span class="map-marker__pin"></span>
                        </div>

                        <div class="map-popup" style="top: 39%; left: 59%;">
                            <div class="map-popup__title">Phòng gác lửng – Hòa Minh</div>
                            <div class="map-popup__meta">2.000.000 đ/tháng • 18 m²</div>
                        </div>

                        <div class="map-zoom">
                            <button type="button" class="map-zoom__btn" aria-label="Phóng to">+</button>
                            <button type="button" class="map-zoom__btn" aria-label="Thu nhỏ">−</button>
                        </div>

                        <div class="map-legend">
                            <span class="map-legend__item"><span class="map-legend__dot map-legend__dot--blue"></span> Phòng trọ</span>
                            <span class="map-legend__item"><span class="map-legend__dot map-legend__dot--orange"></span> Phòng đang chọn</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="map-side-panel">
                    <div class="map-side-card">
                        <h2 class="map-side-card__title">Phòng đang chọn</h2>
                        <div class="map-room-card">
                            <img class="map-room-card__img" src="https://images.unsplash.com/photo-1494526585095-c41746248156?w=700&h=500&fit=crop" alt="Phòng gác lửng Hòa Minh" />
                            <div class="map-room-card__body">
                                <h3 class="map-room-card__name">Phòng gác lửng – Hòa Minh</h3>
                                <div class="map-room-card__location">Liên Chiểu, Đà Nẵng</div>
                                <div class="map-room-card__price">2.000.000 đ/tháng</div>
                                <div class="map-room-card__meta">18 m², WC riêng</div>
                                <div class="map-room-card__amenities">
                                    <span>Wifi</span>
                                    <span>Máy giặt</span>
                                    <span>Bếp</span>
                                    <span>Điều hòa</span>
                                    <span>P. cháy</span>
                                </div>
                                <a class="btn btn-primary map-room-card__btn" href="/PhongTro/ChiTiet">Xem chi tiết phòng</a>
                            </div>
                        </div>
                    </div>

                    <div class="map-side-card">
                        <h2 class="map-side-card__title">Lộ trình gợi ý</h2>
                        <div class="map-route">
                            <div class="map-route__point map-route__point--start">Vị trí của bạn</div>
                            <div class="map-route__line"></div>
                            <div class="map-route__point map-route__point--end">Phòng gác lửng – Hòa Minh</div>
                        </div>

                        <div class="map-route-options">
                            <div class="map-route-option"><strong>Ô tô</strong><span>18 phút • 6,2 km</span></div>
                            <div class="map-route-option"><strong>Xe máy</strong><span>16 phút • 5,6 km</span></div>
                            <div class="map-route-option"><strong>Đi bộ</strong><span>1 giờ 15 phút • 5,6 km</span></div>
                        </div>

                        <a class="map-side-card__link" href="#">Xem chỉ đường</a>
                    </div>

                    <div class="map-side-card">
                        <h2 class="map-side-card__title">Địa điểm lân cận</h2>
                        <ul class="map-nearby-list">
                            <li>Chợ Hòa Khánh</li>
                            <li>Trường THPT Liên Chiểu</li>
                            <li>Bến xe Trung tâm</li>
                        </ul>
                        <a class="map-side-card__link" href="#">Xem thêm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
