@{
    // ActiveLandlordMenu: TongQuan | PhongCuThe | LoaiPhong | TienNghi | HinhAnh | BaiDang | YeuCauThue | CaiDat
    var activeMenu = ViewData["ActiveLandlordMenu"]?.ToString() ?? "";
}

<aside class="landlord-sidebar collapse d-lg-block" id="landlordSidebarCollapse" aria-label="Menu chủ trọ">
    <div class="landlord-sidebar__inner">
        <nav class="landlord-sidebar__nav" aria-label="Menu chủ trọ">
            <a class="landlord-sidebar__link @(activeMenu == "TongQuan" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="TongQuan">
                <i class="bi bi-grid-1x2-fill landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Tổng quan</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "PhongCuThe" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="PhongCuThe">
                <i class="bi bi-house-door landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Phòng/Phòng trọ</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "LoaiPhong" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="LoaiPhong">
                <i class="bi bi-layout-text-window landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Loại phòng</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "TienNghi" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="TienNghi">
                <i class="bi bi-stars landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Tiện nghi</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "HinhAnh" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="HinhAnh">
                <i class="bi bi-images landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Hình ảnh</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "BaiDang" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="BaiDang">
                <i class="bi bi-megaphone landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Tin đăng</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "YeuCauThue" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="YeuCauThue">
                <i class="bi bi-calendar-check landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Yêu cầu thuê</span>
            </a>
            <a class="landlord-sidebar__link @(activeMenu == "CaiDat" ? "is-active" : "")"
               asp-controller="ChuTro" asp-action="CaiDat">
                <i class="bi bi-gear landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Cài đặt</span>
            </a>
        </nav>

        <div class="landlord-card landlord-sidebar__support">
            <h2 class="landlord-sidebar__support-title">Hỗ trợ chủ trọ</h2>
            <p class="landlord-sidebar__support-item mb-1">
                <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                <a href="tel:0901234567">0901 234 567</a>
            </p>
            <p class="landlord-sidebar__support-item mb-0">
                <i class="bi bi-envelope-fill" aria-hidden="true"></i>
                <a href="mailto:hotro@phongtrodannang.vn">hotro@phongtrodannang.vn</a>
            </p>
        </div>

        <form asp-controller="Account" asp-action="Logout" method="post" class="landlord-sidebar__logout-form">
            <button type="submit" class="landlord-sidebar__logout">
                <i class="bi bi-box-arrow-right landlord-sidebar__icon" aria-hidden="true"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>
</aside>
